  "rules": ["rules/siem/evasion-masquerade-system-binary-path.sigma"],
  "intent": {
    "conditions": ["Image name matches a system binary but path is not System32/SysWOW64"],
    "dataSourceRequirements": ["Process creation telemetry with full image path"],
    "tuningParameters": {},
    "sourceContext": "A svchost.exe running from Temp is malware wearing a trusted name."
  }
}

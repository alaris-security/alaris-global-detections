  "slug": "evasion-masquerade-system-binary-path",
  "title": "System Binary Executed from Non-System Path",
  "description": "Detects processes named like core system binaries (svchost.exe, lsass.exe, services.exe) running from a directory other than System32/SysWOW64, a masquerading technique to hide malware behind trusted names.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["defense-evasion", "masquerading"],
  "status": "active",

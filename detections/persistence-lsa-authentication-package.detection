  "intent": {
    "conditions": ["Sysmon event 13 setting Lsa\\Authentication Packages"],
    "dataSourceRequirements": ["Sysmon event 13 (registry value set)"],
    "tuningParameters": {"expectedPackages": ["msv1_0", "wdigest", "kerberos", "schannel"]},
    "sourceContext": "Authentication package DLLs load into LSASS at boot with full credential access."

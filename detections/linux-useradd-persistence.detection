  "intent": {
    "conditions": ["useradd/adduser execution, or writes appending to /etc/passwd"],
    "dataSourceRequirements": ["Linux process execution logs (auditd)"],
    "tuningParameters": {},
    "sourceContext": "New local accounts, especially privileged ones, are persistence backdoors."

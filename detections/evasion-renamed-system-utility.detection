  "rules": ["rules/siem/evasion-renamed-system-utility.sigma"],
  "intent": {
    "conditions": ["OriginalFileName is a known LOLBin but Image name differs"],
    "dataSourceRequirements": ["Process creation telemetry with OriginalFileName"],
    "tuningParameters": {},
    "sourceContext": "Renaming powershell to something benign evades name-based detections."
  }
}

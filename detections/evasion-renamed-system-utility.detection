  "slug": "evasion-renamed-system-utility",
  "title": "Renamed System Utility Execution",
  "description": "Detects execution of a renamed system utility, where the on-disk image name does not match the PE OriginalFileName (e.g. a renamed powershell.exe or rundll32.exe), a masquerading and detection-evasion technique.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["defense-evasion", "masquerading"],
  "status": "active",

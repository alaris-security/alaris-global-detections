  "slug": "collection-gui-credential-prompt",
  "title": "Fake GUI Credential Prompt",
  "description": "Detects scripted display of a credential prompt via PowerShell Get-Credential or CredUIPromptForCredentials, used to phish a logged-on user's password directly on the endpoint.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["collection", "input-capture", "credential-access"],
  "status": "active",
  "mitre": [{"techniqueId": "T1056.002", "tacticId": "TA0009"}],
  "rules": ["rules/siem/collection-gui-credential-prompt.sigma"],
  "intent": {
    "conditions": ["Get-Credential or CredUIPromptForCredentials invoked from a script"],
    "dataSourceRequirements": ["PowerShell logging or process command line"],
    "tuningParameters": {},
    "sourceContext": "A surprise credential dialog is a classic on-host phishing prompt."
  }
}

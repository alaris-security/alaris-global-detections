  "rules": ["rules/siem/exec-wscript-suspicious-script.sigma"],
  "intent": {
    "conditions": ["wscript/cscript with a script path in Temp/AppData/Downloads/Public"],
    "dataSourceRequirements": ["Process creation telemetry with command line"],
    "tuningParameters": {},
    "sourceContext": "Script hosts running files from user temp paths are a hallmark of phishing payloads."
  }

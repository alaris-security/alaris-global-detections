  "title": "WScript/CScript Executing Script from Temp",
  "description": "Detects wscript.exe or cscript.exe running .vbs, .js, or .wsf files from user-writable directories such as Temp, AppData, and Downloads, a common malware delivery execution pattern.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["execution", "wscript", "vbscript"],
  "status": "active",

{
  "uuid": "b80bfb51-8c77-4bad-9e02-dcf79fb97d49",
  "slug": "wdigest-credential-caching-enabled",
  "title": "WDigest Plaintext Credential Caching Enabled",
  "description": "Detects the WDigest UseLogonCredential registry value being set to 1, which re-enables cleartext credential caching in LSASS on modern Windows — a common precursor that adversaries set before dumping plaintext passwords from memory.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["defense-evasion", "credential-access", "wdigest", "registry-modification"],
  "status": "active",
  "mitre": [
    { "techniqueId": "T1112", "tacticId": "TA0005" },
    { "techniqueId": "T1003.001", "tacticId": "TA0006" }
  ],
  "rules": ["rules/siem/wdigest-credential-caching-enabled.sigma"],
  "intent": {
    "conditions": [
      "Registry value HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest\\UseLogonCredential set to DWORD 1"
    ],
    "dataSourceRequirements": [
      "Windows registry-modification telemetry with the target value name and written data (Sysmon EID 13 registry_set, or equivalent)"
    ],
    "tuningParameters": {
      "allowedSourceProcesses": []
    },
    "sourceContext": "Modern Windows disables WDigest plaintext caching by default; setting UseLogonCredential to 1 forces LSASS to keep cleartext passwords until reboot. NOTE: this rule uses only plain field matches (endswith on the registry path plus an exact value match) with no field-to-field comparison, field-exists, or correlation, so it compiles cleanly to Elastic Security EQL as well as Splunk, CrowdStrike, and the other supported backends."
  }
}

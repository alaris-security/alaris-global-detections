  "slug": "gcp-storage-bucket-public",
  "title": "GCP Cloud Storage Bucket Made Public",
  "description": "Detects storage.setIamPermissions granting allUsers or allAuthenticatedUsers access to a Cloud Storage bucket, exposing data publicly and enabling exfiltration.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["exfiltration", "gcp", "cloud-storage"],
  "status": "active",

  "rules": ["rules/siem/gcp-storage-bucket-public.sigma"],
  "intent": {
    "conditions": ["storage.setIamPermissions adding allUsers/allAuthenticatedUsers"],
    "dataSourceRequirements": ["GCP Cloud Audit Logs"],
    "tuningParameters": {},
    "sourceContext": "Public GCS buckets can be read by anyone, enabling data theft."
  }

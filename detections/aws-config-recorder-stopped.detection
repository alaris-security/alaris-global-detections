  "rules": ["rules/siem/aws-config-recorder-stopped.sigma"],
  "intent": {
    "conditions": ["config StopConfigurationRecorder/DeleteConfigurationRecorder/DeleteDeliveryChannel"],
    "dataSourceRequirements": ["AWS CloudTrail management events"],
    "tuningParameters": {},
    "sourceContext": "Stopping AWS Config removes the record of resource changes."
  }
}

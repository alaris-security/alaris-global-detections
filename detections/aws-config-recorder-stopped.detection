  "title": "AWS Config Recorder Stopped or Deleted",
  "description": "Detects StopConfigurationRecorder, DeleteConfigurationRecorder, or DeleteDeliveryChannel, which halt AWS Config resource tracking and remove a source of change history used for detection and forensics.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["defense-evasion", "aws", "config"],

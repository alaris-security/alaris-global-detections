  "intent": {
    "conditions": [
      "Sysmon event 13 writing HKCU ms-settings\\shell\\open\\command or DelegateExecute",
      "Or fodhelper.exe spawning a shell child process"
    ],
    "dataSourceRequirements": ["Sysmon event 13 (registry value set) and event 1 (process create)"],
    "tuningParameters": {},
    "sourceContext": "fodhelper.exe auto-elevates without a prompt; a hijacked ms-settings handler runs attacker code as admin."

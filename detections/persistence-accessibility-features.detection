  "rules": ["rules/siem/persistence-accessibility-features.sigma"],
  "intent": {
    "conditions": ["cmd.exe or powershell spawned as a child of an accessibility binary", "Or an IFEO Debugger set on an accessibility binary"],
    "dataSourceRequirements": ["Process creation telemetry with parent-child lineage"],
    "tuningParameters": {},
    "sourceContext": "Accessibility binaries run as SYSTEM from the lock screen; a shell child is a backdoor."

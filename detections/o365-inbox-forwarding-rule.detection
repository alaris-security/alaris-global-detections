  "rules": ["rules/siem/o365-inbox-forwarding-rule.sigma"],
  "intent": {
    "conditions": ["New-InboxRule/Set-InboxRule with ForwardTo/RedirectTo to an external domain"],
    "dataSourceRequirements": ["M365 Unified Audit Log (Exchange)"],
    "tuningParameters": {},
    "sourceContext": "Auto-forwarding rules quietly siphon a victim's incoming mail."
  }

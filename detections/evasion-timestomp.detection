  "intent": {
    "conditions": ["PowerShell setting CreationTime/LastWriteTime, or touch -r/-t referencing a payload"],
    "dataSourceRequirements": ["Process creation telemetry with command line"],
    "tuningParameters": {},
    "sourceContext": "Backdating a file's timestamps hides it from timeline-based investigation."

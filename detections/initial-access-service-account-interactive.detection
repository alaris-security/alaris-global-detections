    "conditions": ["4624 LogonType 2 or 10 for an account matching the service-account naming pattern"],
    "dataSourceRequirements": ["Windows Security log event 4624"],
    "tuningParameters": {"serviceAccountPattern": "svc_"},
    "sourceContext": "Service accounts should never log on interactively; doing so signals misuse."

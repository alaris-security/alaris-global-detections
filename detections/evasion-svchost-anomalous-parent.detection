  "title": "svchost.exe with Anomalous Parent",
  "description": "Detects svchost.exe spawned by a parent other than services.exe (or the expected system parents), a strong indicator of a masquerading process or injected host impersonating the service host.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["defense-evasion", "masquerading", "svchost"],
  "status": "active",

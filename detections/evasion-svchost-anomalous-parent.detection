  "rules": ["rules/siem/evasion-svchost-anomalous-parent.sigma"],
  "intent": {
    "conditions": ["svchost.exe whose parent is not services.exe/MsMpEng/ngen"],
    "dataSourceRequirements": ["Process creation telemetry with parent lineage"],
    "tuningParameters": {},
    "sourceContext": "Legitimate svchost is spawned by services.exe; other parents are suspicious."
  }
}

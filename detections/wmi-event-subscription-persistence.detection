  "rules": [
    "rules/siem/wmi-event-subscription-persistence.sigma"
  ],
  "intent": {
    "conditions": [
      "Sysmon event 19 (WmiEventFilter), 20 (WmiEventConsumer), or 21 (WmiEventConsumerToFilter)",
      "CommandLineTemplate or Destination references a scripting interpreter or encoded payload"
    ],
    "dataSourceRequirements": [
      "Sysmon events 19, 20, 21 (WMI activity)"
    ],
    "tuningParameters": {
      "allowedConsumers": [
        "SCM Event Log Consumer"

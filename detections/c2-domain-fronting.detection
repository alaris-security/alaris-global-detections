  "intent": {
    "conditions": ["HTTP Host header differs from the TLS SNI / requested CDN endpoint"],
    "dataSourceRequirements": ["TLS and HTTP inspection logs with SNI and Host fields"],
    "tuningParameters": {},
    "sourceContext": "A mismatch between SNI and Host is the defining artifact of domain fronting."
  }

  "rules": ["rules/siem/linux-container-escape-attempt.sigma"],
  "intent": {
    "conditions": ["release_agent writes, nsenter -t 1, or runc /proc/self/exe overwrite patterns"],
    "dataSourceRequirements": ["Linux process execution logs"],
    "tuningParameters": {},
    "sourceContext": "These primitives are the well-known building blocks of container escapes."
  }

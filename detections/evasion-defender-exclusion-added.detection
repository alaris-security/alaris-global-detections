  "intent": {
    "conditions": ["Add-MpPreference -Exclusion*, or registry write under Windows Defender\\Exclusions"],
    "dataSourceRequirements": ["Process command line and Sysmon event 13"],
    "tuningParameters": {},
    "sourceContext": "Exclusions let attackers stage tooling in a folder Defender ignores."
  }

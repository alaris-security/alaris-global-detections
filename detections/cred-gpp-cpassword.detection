  "slug": "cred-gpp-cpassword",
  "title": "Group Policy Preferences cPassword Retrieval",
  "description": "Detects access to Group Policy Preferences XML files in SYSVOL containing the cPassword attribute, whose AES key is public, allowing trivial recovery of embedded local admin passwords.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["credential-access", "gpp", "sysvol"],
  "status": "active",
  "mitre": [{"techniqueId": "T1552.006", "tacticId": "TA0006"}],
  "rules": ["rules/siem/cred-gpp-cpassword.sigma"],
  "intent": {
    "conditions": ["Access to Groups.xml/Services.xml in SYSVOL Policies", "Or Get-GPPPassword tooling"],
    "dataSourceRequirements": ["Process creation telemetry with command line"],
    "tuningParameters": {},
    "sourceContext": "GPP cPassword is decryptable by anyone; SYSVOL access to these files is credential theft."
  }
}

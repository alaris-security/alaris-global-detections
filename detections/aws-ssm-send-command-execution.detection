  "slug": "aws-ssm-send-command-execution",
  "title": "AWS SSM Remote Command Execution",
  "description": "Detects SSM SendCommand or StartSession, which run commands directly on EC2 instances through the cloud control plane, a technique to execute code on hosts without SSH or RDP.",
  "severity": "high",
  "families": ["siem"],
  "tags": ["execution", "aws", "ssm", "cloud-admin"],
  "status": "active",

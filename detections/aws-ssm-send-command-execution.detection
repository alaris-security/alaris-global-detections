  "rules": ["rules/siem/aws-ssm-send-command-execution.sigma"],
  "intent": {
    "conditions": ["ssm SendCommand with a RunShellScript/RunPowerShellScript document, or StartSession"],
    "dataSourceRequirements": ["AWS CloudTrail management events"],
    "tuningParameters": {},
    "sourceContext": "SSM lets an identity run commands on instances via the API, bypassing host access controls."
  }

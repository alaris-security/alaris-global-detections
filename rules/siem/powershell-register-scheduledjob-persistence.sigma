title: PowerShell Scheduled Job Persistence
id: 88cc4a65-6a8e-4806-9c82-fa1bdd49e7ca
status: experimental
description: Detects creation of a PowerShell scheduled job (Register-ScheduledJob / New-JobTrigger), which persists as a task under the Microsoft\Windows\PowerShell\ScheduledJobs path and runs script blocks on a trigger.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1053/005/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Register-ScheduledJob'
      - 'New-JobTrigger'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Legitimate scheduled automation
level: medium
tags:
  - attack.persistence
  - attack.t1053.005

title: Data Collection from Removable Media
id: 86daf9e9-0949-4fa3-8f13-44b1a618c1ab
status: experimental
description: Detects collection from removable media.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1025/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'copy'
      - 'Copy-Item'
      - 'xcopy'
    CommandLine|re: '[E-Z]:\\.*C:\\'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Users importing files from USB
level: low
tags:
  - attack.collection
  - attack.t1025

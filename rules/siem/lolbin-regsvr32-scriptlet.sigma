title: Regsvr32 Squiblydoo Remote Scriptlet Execution
id: bee87f88-765c-45d7-baee-6a9890c3df06
status: experimental
description: Detects regsvr32 remote scriptlet (Squiblydoo) execution.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1218/010/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\regsvr32.exe'
    CommandLine|contains:
      - 'scrobj'
      - '/i:http'
      - '/i:ftp'
      - '.sct'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legitimate COM component registration referencing scrobj
level: high
tags:
  - attack.defense_evasion
  - attack.t1218.010

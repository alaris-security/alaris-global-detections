title: Linux Cron Job Persistence
id: f2fd2f23-bff4-494f-9f57-7d7720ae1df4
status: experimental
description: Detects cron-based persistence.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1053/003/
logsource:
  product: linux
  category: process_creation
detection:
  selection_cmd:
    Image|endswith: '/crontab'
    CommandLine|contains:
      - '-e'
      - '-r'
  selection_path:
    CommandLine|contains:
      - '/etc/cron.d/'
      - '/etc/crontab'
      - '/var/spool/cron/'
      - '/etc/cron.hourly/'
      - '/etc/cron.daily/'
  condition: selection_cmd or selection_path
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Administrators and configuration management editing cron
level: medium
tags:
  - attack.persistence
  - attack.t1053.003

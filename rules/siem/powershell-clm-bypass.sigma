title: PowerShell Constrained Language Mode Bypass
id: 4d870a1b-a008-4bdc-8f23-bcc369f6f15e
status: experimental
description: Detects attempts to bypass PowerShell Constrained Language Mode, such as invoking older engine versions (-Version 2), custom runspaces, or setting __PSLockdownPolicy, used to regain full-language script execution.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '-Version 2'
      - '__PSLockdownPolicy'
      - 'InitialSessionState'
      - 'runspace'
    CommandLine|contains:
      - 'FullLanguage'
      - 'CreateRunspace'
      - 'v2.0.50727'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Legacy scripts requiring PowerShell v2
level: high
tags:
  - attack.defense_evasion
  - attack.t1059.001

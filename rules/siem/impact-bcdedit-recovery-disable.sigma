title: Boot Recovery Disabled via bcdedit
id: 8b89a9b2-c4fa-4a01-b852-f660d0e5c7af
status: experimental
description: Detects bcdedit recovery inhibition.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1490/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\bcdedit.exe'
    CommandLine|contains:
      - 'recoveryenabled no'
      - 'bootstatuspolicy ignoreallfailures'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Rare administrative boot configuration changes
level: high
tags:
  - attack.impact
  - attack.t1490

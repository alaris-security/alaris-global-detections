title: macOS System Integrity Protection Disabled
id: 9cd8be09-9dd8-465e-8502-21592ba4802a
status: experimental
description: Detects disabling of SIP.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/001/
logsource:
  product: macos
  category: process_creation
detection:
  selection:
    Image|endswith: '/csrutil'
    CommandLine|contains: 'disable'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Developers disabling SIP in recovery for testing
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.001

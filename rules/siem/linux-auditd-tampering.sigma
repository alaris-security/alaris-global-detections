title: Linux auditd Tampering
id: d18bee2f-7d27-4a05-8b52-a80fe3134120
status: experimental
description: Detects disabling of the audit daemon.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/001/
logsource:
  product: linux
  category: process_creation
detection:
  selection_auditctl:
    Image|endswith: '/auditctl'
    CommandLine|contains: '-e 0'
  selection_service:
    CommandLine|contains:
      - 'stop auditd'
      - 'disable auditd'
      - 'mask auditd'
  condition: selection_auditctl or selection_service
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Maintenance of auditing configuration
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.001

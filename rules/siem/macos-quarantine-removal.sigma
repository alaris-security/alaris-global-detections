title: macOS Quarantine Attribute Removal
id: 715bc066-d162-42e6-9c9c-854cb108a2ff
status: experimental
description: Detects removal of the quarantine attribute.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1553/001/
logsource:
  product: macos
  category: process_creation
detection:
  selection:
    Image|endswith: '/xattr'
    CommandLine|contains:
      - 'com.apple.quarantine'
      - '-c'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Developers clearing quarantine on trusted files
level: medium
tags:
  - attack.defense_evasion
  - attack.t1553.001

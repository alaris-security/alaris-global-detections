title: Domain Account Discovery
id: 62226d60-d614-43bf-b1d8-d08461864d2b
status: experimental
description: Detects domain account enumeration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1087/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains|all:
      - 'user'
      - '/domain'
  selection_tools:
    CommandLine|contains:
      - 'dsquery user'
      - 'Get-ADUser'
      - 'Get-ADUser -Filter'
  condition: selection_net or selection_tools
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Directory administration and reporting scripts
level: medium
tags:
  - attack.discovery
  - attack.t1087.002

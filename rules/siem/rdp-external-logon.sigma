title: Inbound RDP Logon from External Address
id: 012a1e34-edab-4794-a633-9c6dc8c25fe1
status: experimental
description: Detects RDP logons originating from non-internal IP addresses.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1021/001/
logsource:
  product: windows
  service: security
detection:
  selection:
    EventID: 4624
    LogonType: 10
  filter_internal:
    IpAddress|startswith:
      - '10.'
      - '192.168.'
      - '172.16.'
      - '172.17.'
      - '172.18.'
      - '127.'
  condition: selection and not filter_internal
fields:
  - TargetUserName
  - IpAddress
  - WorkstationName
falsepositives:
  - Authorized remote administration over exposed RDP or jump hosts
level: high
tags:
  - attack.lateral_movement
  - attack.initial_access
  - attack.t1021.001

title: Accessibility Feature Binary Replacement
id: c3eb7c19-a4f0-4fff-8383-c9e4c550318c
status: experimental
description: Detects accessibility feature abuse for backdoor shells.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1546/008/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith:
      - '\sethc.exe'
      - '\utilman.exe'
      - '\osk.exe'
      - '\magnify.exe'
      - '\narrator.exe'
      - '\displayswitch.exe'
      - '\atbroker.exe'
    Image|endswith:
      - '\cmd.exe'
      - '\powershell.exe'
  condition: selection
fields:
  - ParentImage
  - Image
  - CommandLine
falsepositives:
  - Extremely rare legitimate use
level: critical
tags:
  - attack.persistence
  - attack.privilege_escalation
  - attack.t1546.008

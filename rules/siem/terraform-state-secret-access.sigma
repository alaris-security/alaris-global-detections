title: Terraform State File Secret Access
id: 2dac82ad-2a7e-4eab-af26-f6a2eab60a1f
status: experimental
description: Detects reading of Terraform state files (terraform.tfstate) by copy/read tools, which frequently contain plaintext secrets (DB passwords, keys) captured from resource attributes.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'terraform.tfstate'
    Image|endswith:
      - '/cat'
      - '/cp'
      - '/grep'
      - '/scp'
  condition: selection
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Legitimate state inspection
level: medium
tags:
  - attack.credential_access
  - attack.t1552

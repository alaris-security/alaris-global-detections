title: Pass-the-Hash NTLM Network Logon
id: 50c84942-79d1-4f39-ad2f-f566eadc80af
status: experimental
description: Detects NTLM network logons consistent with pass-the-hash.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1550/002/
logsource:
  product: windows
  service: security
detection:
  selection:
    EventID: 4624
    LogonType: 3
    AuthenticationPackageName: 'NTLM'
    LogonProcessName: 'NtLmSsp'
  filter:
    TargetUserName:
      - 'ANONYMOUS LOGON'
    TargetUserName|endswith: '$'
  condition: selection and not filter
fields:
  - TargetUserName
  - WorkstationName
  - IpAddress
falsepositives:
  - Legacy applications and appliances that still authenticate over NTLM
level: high
tags:
  - attack.lateral_movement
  - attack.t1550.002

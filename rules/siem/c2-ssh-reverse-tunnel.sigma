title: SSH Reverse Port-Forward Tunnel
id: fd01b4b8-c2b4-4f41-a169-16f734b557c8
status: experimental
description: Detects SSH reverse/dynamic tunneling.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1572/
logsource:
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '/ssh'
      - '\ssh.exe'
      - '\plink.exe'
    CommandLine|contains:
      - ' -R '
      - ' -D '
      - '-R '
  selection_bg:
    CommandLine|contains:
      - '-N'
      - '-f'
  condition: selection and selection_bg
fields:
  - CommandLine
  - User
  - ParentImage
falsepositives:
  - Administrators creating legitimate tunnels
level: high
tags:
  - attack.command_and_control
  - attack.t1572

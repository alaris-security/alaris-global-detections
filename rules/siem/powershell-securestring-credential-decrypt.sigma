title: PowerShell SecureString Credential Decryption
id: c4063329-726c-4a4d-a9ce-f06d69e8e549
status: experimental
description: Detects PowerShell decrypting stored credentials (ConvertTo-SecureString with -Key/-AsPlainText, or GetNetworkCredential().Password), used to recover plaintext passwords from saved credential files.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'ConvertTo-SecureString'
      - 'GetNetworkCredential().Password'
      - 'ConvertFrom-SecureString'
    CommandLine|contains:
      - '-Key'
      - '-AsPlainText'
      - '.Password'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Legitimate credential automation
level: medium
tags:
  - attack.credential_access
  - attack.t1555

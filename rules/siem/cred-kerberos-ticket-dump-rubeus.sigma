title: Kerberos Ticket Dump via Rubeus
id: e8c8741b-f657-4d79-9807-ec7316051b5c
status: experimental
description: Detects Kerberos ticket dumping.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1558/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Rubeus'
      - 'sekurlsa::tickets'
      - 'tgtdeleg'
      - 'kerberos::list /export'
      - 'dump /service:krbtgt'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Authorized red team testing
level: high
tags:
  - attack.credential_access
  - attack.t1558

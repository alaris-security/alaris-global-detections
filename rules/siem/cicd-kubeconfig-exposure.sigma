title: Kubeconfig Written to CI Workspace
id: 3ee2d1f2-4249-42b8-97f7-1bc8e9453d22
status: experimental
description: Detects a pipeline step writing a kubeconfig or cluster token to the build workspace or echoing it, exposing cluster credentials that can be captured from CI logs or artifacts.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'kubeconfig'
      - 'kubectl config set-credentials'
    CommandLine|contains:
      - 'echo'
      - '>'
      - 'cat'
  condition: selection
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Legitimate cluster auth setup
level: medium
tags:
  - attack.credential_access
  - attack.t1552

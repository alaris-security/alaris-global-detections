title: Application Shim Database Installation
id: acb16d11-3beb-498e-896b-74a4686f02de
status: experimental
description: Detects application shim database installation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1546/011/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\sdbinst.exe'
    CommandLine|contains: '.sdb'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legacy application compatibility fixes by IT
level: high
tags:
  - attack.persistence
  - attack.t1546.011

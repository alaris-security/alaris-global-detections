title: Windows Service Binary Path Modified
id: c26cb583-dc59-4bbd-8afe-3b164f2e3549
status: experimental
description: Detects service binPath modification.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1543/003/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\sc.exe'
    CommandLine|contains: 'config'
    CommandLine|contains: 'binPath'
  selection_susp:
    CommandLine|contains:
      - 'cmd'
      - 'powershell'
      - '\Temp\'
      - '\AppData\'
  condition: selection and selection_susp
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legitimate service reconfiguration
level: high
tags:
  - attack.privilege_escalation
  - attack.t1543.003

title: UAC Bypass via computerdefaults.exe
id: 24604649-c21d-414a-95c7-f62b0cd1f7d6
status: experimental
description: Detects computerdefaults UAC bypass.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1548/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith: '\computerdefaults.exe'
    Image|endswith:
      - '\cmd.exe'
      - '\powershell.exe'
  condition: selection
fields:
  - ParentImage
  - Image
  - CommandLine
falsepositives:
  - None expected
level: high
tags:
  - attack.privilege_escalation
  - attack.t1548.002

title: Browser Drive-By Compromise
id: 8a8d9e55-657e-47bb-857f-3ce366c6f5d5
status: experimental
description: Detects browser spawning shells or scripts.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1189/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith:
      - '\chrome.exe'
      - '\msedge.exe'
      - '\firefox.exe'
      - '\iexplore.exe'
    Image|endswith:
      - '\cmd.exe'
      - '\powershell.exe'
      - '\wscript.exe'
      - '\mshta.exe'
      - '\regsvr32.exe'
  condition: selection
fields:
  - ParentImage
  - Image
  - CommandLine
falsepositives:
  - Browser helper integrations launching utilities
level: high
tags:
  - attack.initial_access
  - attack.t1189

title: Azure Key Vault Bulk Secret Access
id: 8157ad4f-5fa6-42fa-9797-6db5de02e420
status: experimental
description: Detects bulk Key Vault secret access.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/
logsource:
  product: azure
  service: activitylogs
detection:
  selection:
    operationName: 'SecretGet'
  timeframe: 10m
  condition: selection | count() by identity > 20
fields:
  - identity
  - resourceId
  - callerIpAddress
falsepositives:
  - Applications loading many secrets at startup
level: high
tags:
  - attack.credential_access
  - attack.t1555

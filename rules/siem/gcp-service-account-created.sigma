title: GCP Service Account Created
id: f063225b-b3d0-4ab4-bc11-c16e7530cc78
status: experimental
description: Detects service account creation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1136/003/
logsource:
  product: gcp
  service: gcp.audit
detection:
  selection:
    data.protoPayload.methodName|endswith: 'CreateServiceAccount'
  condition: selection
fields:
  - data.protoPayload.authenticationInfo.principalEmail
  - data.protoPayload.resourceName
falsepositives:
  - Provisioning automation
level: medium
tags:
  - attack.persistence
  - attack.t1136.003

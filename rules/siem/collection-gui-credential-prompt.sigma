title: Fake GUI Credential Prompt
id: f7231446-6761-4136-b96a-f4c98a3eef52
status: experimental
description: Detects scripted credential prompts.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1056/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Get-Credential'
      - 'CredUIPromptForCredentials'
      - 'PromptForCredential'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Administrative scripts prompting for credentials
level: high
tags:
  - attack.collection
  - attack.t1056.002

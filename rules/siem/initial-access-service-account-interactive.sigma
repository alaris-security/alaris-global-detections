title: Interactive Logon by Service Account
id: dfda3726-61d7-472b-8e73-6a18a6da5065
status: experimental
description: Detects interactive logon by service accounts.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1078/
logsource:
  product: windows
  service: security
detection:
  selection:
    EventID: 4624
    LogonType:
      - 2
      - 10
    TargetUserName|startswith:
      - 'svc_'
      - 'svc-'
      - 'service_'
  condition: selection
fields:
  - TargetUserName
  - LogonType
  - IpAddress
  - WorkstationName
falsepositives:
  - Service accounts intentionally used for interactive tasks
level: high
tags:
  - attack.initial_access
  - attack.t1078

title: Group Policy Preferences cPassword Retrieval
id: cbe329e9-bf36-44ad-b0b2-5f8b22c85455
status: experimental
description: Detects Group Policy Preferences password retrieval.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/006/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Get-GPPPassword'
      - 'cpassword'
      - '\SYSVOL\'
    CommandLine|contains:
      - 'Groups.xml'
      - 'Services.xml'
      - 'ScheduledTasks.xml'
      - 'Get-GPPPassword'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Security teams auditing SYSVOL for GPP passwords
level: high
tags:
  - attack.credential_access
  - attack.t1552.006

title: Git Stored Credential Theft
id: 0a3e6aa5-a287-4615-a5f7-b1d201942a7f
status: experimental
description: Detects access to git credential stores.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '.git-credentials'
      - '.netrc'
      - 'credential-store'
  selection_tool:
    Image|endswith:
      - '/cat'
      - '/cp'
      - '\cmd.exe'
      - '\powershell.exe'
  condition: selection and selection_tool
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Developer tooling reading credentials
level: medium
tags:
  - attack.credential_access
  - attack.t1552.001

title: Browser Credential Store Access
id: 181c70e5-9b59-498a-87d5-d42dea2dc5a2
status: experimental
description: Detects access to browser credential stores.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/003/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '\User Data\Default\Login Data'
      - '\User Data\Local State'
      - 'key4.db'
      - 'logins.json'
      - 'cookies.sqlite'
  filter:
    Image|endswith:
      - '\chrome.exe'
      - '\msedge.exe'
      - '\firefox.exe'
  condition: selection and not filter
fields:
  - CommandLine
  - Image
falsepositives:
  - Backup utilities copying browser profiles
level: high
tags:
  - attack.credential_access
  - attack.t1555.003

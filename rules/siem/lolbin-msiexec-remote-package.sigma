title: Msiexec Remote MSI Package Installation
id: a2329996-54fd-4801-9cac-70677ba2a362
status: experimental
description: Detects msiexec installing packages from remote URLs.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1218/007/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\msiexec.exe'
    CommandLine|contains:
      - 'http://'
      - 'https://'
      - 'ftp://'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Enterprise software deployed from internal package URLs
level: high
tags:
  - attack.defense_evasion
  - attack.t1218.007

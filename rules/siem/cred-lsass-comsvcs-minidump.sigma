title: LSASS MiniDump via comsvcs.dll
id: 75f3f69e-a793-4aff-b142-eaedd5a8a920
status: experimental
description: Detects LSASS dumping via comsvcs.dll MiniDump.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1003/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'comsvcs'
    CommandLine|contains:
      - 'MiniDump'
      - '#24'
      - 'FullMemory'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - None expected
level: critical
tags:
  - attack.credential_access
  - attack.t1003.001

title: Offensive PowerShell Toolkit Function
id: da4dc531-3229-4eaa-9dd1-18e9c56606be
status: experimental
description: Detects invocation of well-known offensive PowerShell functions from PowerSploit, Nishang, and PowerUp (Invoke-Mimikatz, Invoke-Shellcode, Invoke-PowerDump, Get-System), a strong signal of post-exploitation tooling.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Invoke-Mimikatz'
      - 'Invoke-Shellcode'
      - 'Invoke-PowerDump'
      - 'Invoke-ReflectivePEInjection'
      - 'Invoke-DllInjection'
      - 'Get-System'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Authorized red team assessments
level: high
tags:
  - attack.execution
  - attack.t1059.001

title: Pip Install from Untrusted Source
id: fc57c822-2adc-4e3b-b5b1-15adbcdf7ae2
status: experimental
description: Detects pip install pulling from a non-standard index or a git/URL source (--index-url, git+http, direct URL), a technique to introduce malicious or backdoored packages outside the trusted registry.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1195/002/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'pip'
    CommandLine|contains: 'install'
    CommandLine|contains:
      - '--index-url'
      - '--extra-index-url'
      - 'git+http'
      - 'http://'
  condition: selection
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Internal package mirrors (allowlist them)
level: medium
tags:
  - attack.persistence
  - attack.t1195.002

title: AWS Policy Version Rollback for Privilege Escalation
id: 83b36d35-147a-4c0d-bad2-57eafb79163a
status: experimental
description: Detects IAM policy version manipulation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/003/
logsource:
  product: aws
  service: cloudtrail
detection:
  selection:
    eventSource: 'iam.amazonaws.com'
    eventName:
      - 'CreatePolicyVersion'
      - 'SetDefaultPolicyVersion'
  condition: selection
fields:
  - userIdentity.arn
  - requestParameters.policyArn
  - sourceIPAddress
falsepositives:
  - Policy lifecycle management by IAM administrators
level: high
tags:
  - attack.privilege_escalation
  - attack.t1098.003

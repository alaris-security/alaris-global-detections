title: PowerShell Hidden Window with Execution Bypass
id: 4413a159-0e9e-438b-a0e1-91e44e6beb50
status: experimental
description: Detects stealthy PowerShell invocation flags.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\powershell.exe'
      - '\pwsh.exe'
    CommandLine|contains:
      - '-w hidden'
      - '-windowstyle hidden'
      - '-WindowStyle h'
    CommandLine|contains:
      - '-ep bypass'
      - 'ExecutionPolicy Bypass'
      - '-nop'
      - '-noprofile'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Some legitimate management agents
level: high
tags:
  - attack.execution
  - attack.t1059.001

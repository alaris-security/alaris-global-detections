title: Macro-Enabled Document Retrieving Remote Content
id: 36130bbb-68ed-4c75-9eb0-142c305e6819
status: experimental
description: Detects Office documents fetching remote payloads.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1566/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith:
      - '\winword.exe'
      - '\excel.exe'
      - '\powerpnt.exe'
    Image|endswith:
      - '\certutil.exe'
      - '\bitsadmin.exe'
      - '\powershell.exe'
      - '\mshta.exe'
    CommandLine|contains: 'http'
  condition: selection
fields:
  - ParentImage
  - Image
  - CommandLine
falsepositives:
  - Rare document automation contacting internal URLs
level: high
tags:
  - attack.initial_access
  - attack.t1566.001

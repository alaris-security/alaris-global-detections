title: Certutil Used to Download or Decode Payloads
id: 1efdad9a-b7be-4154-8dec-aa291eb56e37
status: experimental
description: Detects certutil ingress transfer and decode abuse.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1105/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\certutil.exe'
    CommandLine|contains:
      - '-urlcache'
      - 'urlcache'
      - '-verifyctl'
      - '-decode'
      - '-split'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Administrative certificate management scripts
level: high
tags:
  - attack.command_and_control
  - attack.t1105

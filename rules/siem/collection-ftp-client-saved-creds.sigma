title: FTP Client Saved Credential Theft
id: b01fef17-5bb7-4fcd-9b27-0e95f2e9ab78
status: experimental
description: Detects access to FTP/SFTP client credential stores (FileZilla sitemanager.xml and recentservers.xml, WinSCP.ini), which store server credentials often in cleartext or trivially reversible form.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'sitemanager.xml'
      - 'recentservers.xml'
      - 'WinSCP.ini'
      - 'FileZilla'
    Image|endswith:
      - '/cat'
      - '/cp'
      - '\\cmd.exe'
      - '\\powershell.exe'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Backup software
level: medium
tags:
  - attack.credential_access
  - attack.t1552.001

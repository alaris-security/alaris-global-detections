title: Entra ID Sign-In from Anonymous IP
id: 54777e2f-f14c-4cff-aeb8-76316e353bb0
status: experimental
description: Detects sign-ins from anonymized IP addresses.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1078/004/
logsource:
  product: azure
  service: signinlogs
detection:
  selection:
    RiskEventTypes|contains: 'anonymizedIPAddress'
    ResultType: '0'
  condition: selection
fields:
  - UserPrincipalName
  - IPAddress
  - RiskLevelDuringSignIn
falsepositives:
  - Privacy-conscious users on VPNs
level: high
tags:
  - attack.initial_access
  - attack.t1078.004

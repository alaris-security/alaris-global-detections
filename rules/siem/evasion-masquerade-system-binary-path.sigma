title: System Binary Executed from Non-System Path
id: 3a41e8b5-abe7-4e37-b409-6624fbd5fa93
status: experimental
description: Detects system binaries running from unusual paths.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1036/005/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\svchost.exe'
      - '\lsass.exe'
      - '\services.exe'
      - '\csrss.exe'
      - '\winlogon.exe'
  filter:
    Image|startswith:
      - 'C:\Windows\System32\'
      - 'C:\Windows\SysWOW64\'
      - 'C:\Windows\WinSxS\'
  condition: selection and not filter
fields:
  - Image
  - ParentImage
  - CommandLine
falsepositives:
  - None expected
level: high
tags:
  - attack.defense_evasion
  - attack.t1036.005

title: Linux Execution from Hidden Directory
id: 36bb08fa-3ba9-4280-aa74-baaff0856e90
status: experimental
description: Detects execution from hidden directories.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1564/001/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    Image|contains:
      - '/tmp/.'
      - '/dev/shm/.'
      - '/var/tmp/.'
      - '/.hidden/'
  condition: selection
fields:
  - Image
  - CommandLine
  - User
falsepositives:
  - Some applications use dot-directories legitimately
level: medium
tags:
  - attack.defense_evasion
  - attack.t1564.001

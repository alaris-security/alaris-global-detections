title: PowerShell Compressed Payload Decode and Execute
id: b4592c7a-afec-450f-abc0-f2bcc842435a
status: experimental
description: Detects PowerShell decompressing an embedded base64+GZip/Deflate blob and piping it to Invoke-Expression, a common packing technique to hide the real script from static inspection.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1027/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'GzipStream'
      - 'DeflateStream'
      - 'MemoryStream'
    CommandLine|contains:
      - 'FromBase64String'
    CommandLine|contains:
      - 'IEX'
      - 'Invoke-Expression'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Legitimate compressed script delivery
level: high
tags:
  - attack.defense_evasion
  - attack.t1027

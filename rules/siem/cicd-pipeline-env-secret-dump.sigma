title: CI Pipeline Environment Secret Dump
id: 04f69035-c66e-4f68-8afe-4c59172a20b2
status: experimental
description: Detects pipeline steps that print the full environment or secret variables (env, printenv, set, echo of secret vars), a technique to exfiltrate CI secrets through build logs.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'printenv'
      - 'env |'
      - 'set +x'
      - 'echo $'
    CommandLine|contains:
      - 'SECRET'
      - 'TOKEN'
      - 'PASSWORD'
      - 'KEY'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Debugging pipeline steps
level: high
tags:
  - attack.credential_access
  - attack.t1552

title: macOS Cron Job Persistence
id: 2a5d07c3-aabe-4124-bba4-a98d33383fa5
status: experimental
description: Detects cron persistence on macOS.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1053/003/
logsource:
  product: macos
  category: process_creation
detection:
  selection_cmd:
    Image|endswith: '/crontab'
    CommandLine|contains:
      - '-e'
      - '-r'
  selection_path:
    CommandLine|contains: '/usr/lib/cron/tabs/'
  condition: selection_cmd or selection_path
fields:
  - CommandLine
  - User
falsepositives:
  - Administrators scheduling tasks
level: medium
tags:
  - attack.persistence
  - attack.t1053.003

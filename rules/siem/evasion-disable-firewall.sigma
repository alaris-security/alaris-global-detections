title: Windows Firewall Disabled via netsh or PowerShell
id: 1f55936f-4ae5-41c0-83c0-91d889a14dc4
status: experimental
description: Detects disabling of the Windows firewall.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/004/
logsource:
  product: windows
  category: process_creation
detection:
  selection_netsh:
    Image|endswith: '\netsh.exe'
    CommandLine|contains|all:
      - 'advfirewall'
      - 'state off'
  selection_ps:
    CommandLine|contains: 'Set-NetFirewallProfile'
    CommandLine|contains: 'Enabled False'
  condition: selection_netsh or selection_ps
fields:
  - CommandLine
  - Image
falsepositives:
  - Administrators temporarily disabling the firewall for troubleshooting
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.004

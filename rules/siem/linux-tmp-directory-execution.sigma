title: Linux Execution from World-Writable Temp Directory
id: 748b1486-3e0e-45aa-8533-76c0019669ec
status: experimental
description: Detects execution from temp directories.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/004/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    Image|startswith:
      - '/tmp/'
      - '/var/tmp/'
      - '/dev/shm/'
  condition: selection
fields:
  - Image
  - CommandLine
  - User
falsepositives:
  - Package build systems compiling in /tmp
level: medium
tags:
  - attack.execution
  - attack.t1059.004

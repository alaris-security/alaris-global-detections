title: Offline Password Hash Cracking Tool
id: 63f82382-5685-4dc9-ad28-56186a5bba98
status: experimental
description: Detects offline hash cracking tools.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1110/002/
logsource:
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\hashcat.exe'
      - '/hashcat'
      - '/john'
      - '\john.exe'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Authorized password auditing
level: medium
tags:
  - attack.credential_access
  - attack.t1110.002

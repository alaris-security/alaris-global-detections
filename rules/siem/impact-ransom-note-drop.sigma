title: Ransom Note File Creation
id: da8ea9c7-3610-45a3-95ba-0bf37292d5b9
status: experimental
description: Detects ransom note file creation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1486/
logsource:
  product: windows
  category: file_event
detection:
  selection:
    TargetFilename|contains:
      - 'readme'
      - 'how_to_decrypt'
      - 'how-to-decrypt'
      - 'decrypt_instructions'
      - 'recover_files'
      - 'restore_files'
      - '_readme.txt'
    TargetFilename|endswith:
      - '.txt'
      - '.html'
      - '.hta'
  condition: selection
fields:
  - TargetFilename
  - Image
falsepositives:
  - Software shipping README files (rare at this scale)
level: critical
tags:
  - attack.impact
  - attack.t1486

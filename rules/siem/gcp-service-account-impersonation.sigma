title: GCP Service Account Impersonation
id: da5b2b05-f9bc-4a8c-b89b-f9c4cb86ebb6
status: experimental
description: Detects service account impersonation via token generation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1134/
logsource:
  product: gcp
  service: gcp.audit
detection:
  selection:
    data.protoPayload.methodName|contains:
      - 'GenerateAccessToken'
      - 'GenerateIdToken'
      - 'SignBlob'
      - 'SignJwt'
  condition: selection
fields:
  - data.protoPayload.authenticationInfo.principalEmail
  - data.protoPayload.resourceName
falsepositives:
  - Workload identity federation and legitimate impersonation
level: high
tags:
  - attack.privilege_escalation
  - attack.t1134

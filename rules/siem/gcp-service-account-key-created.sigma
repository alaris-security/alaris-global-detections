title: GCP Service Account Key Created
id: 62af790a-e6df-4c7b-bd5c-1cb6c1c23a1d
status: experimental
description: Detects service account key creation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/001/
logsource:
  product: gcp
  service: gcp.audit
detection:
  selection:
    data.protoPayload.methodName|endswith: 'CreateServiceAccountKey'
  condition: selection
fields:
  - data.protoPayload.authenticationInfo.principalEmail
  - data.protoPayload.resourceName
falsepositives:
  - Provisioning automation creating keys
level: high
tags:
  - attack.persistence
  - attack.t1098.001

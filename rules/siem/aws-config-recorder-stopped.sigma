title: AWS Config Recorder Stopped or Deleted
id: ab37c722-1bfb-4c35-9beb-0a8a9613b6db
status: experimental
description: Detects AWS Config recorder tampering.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/008/
logsource:
  product: aws
  service: cloudtrail
detection:
  selection:
    eventSource: 'config.amazonaws.com'
    eventName:
      - 'StopConfigurationRecorder'
      - 'DeleteConfigurationRecorder'
      - 'DeleteDeliveryChannel'
  condition: selection
fields:
  - userIdentity.arn
  - eventName
  - sourceIPAddress
falsepositives:
  - Config reconfiguration by cloud engineering
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.008

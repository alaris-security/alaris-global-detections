title: Local Database Export or Dump
id: f2faff4d-440c-4c3c-93c6-d94f28ac1969
status: experimental
description: Detects database dump/export operations.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1005/
logsource:
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\mysqldump.exe'
      - '/mysqldump'
      - '/pg_dump'
      - '/mongodump'
    CommandLine|contains:
      - '--all-databases'
      - '-o'
      - '--out'
  selection_sqlcmd:
    Image|endswith: '\sqlcmd.exe'
    CommandLine|contains: '-o'
  condition: selection or selection_sqlcmd
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Scheduled database backups
level: high
tags:
  - attack.collection
  - attack.t1005

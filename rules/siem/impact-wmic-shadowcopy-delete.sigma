title: Volume Shadow Copy Deletion via WMIC
id: cda59ec1-3e7d-475b-9191-3b39a015bdd1
status: experimental
description: Detects shadow copy deletion via WMIC/WMI.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1490/
logsource:
  product: windows
  category: process_creation
detection:
  selection_wmic:
    Image|endswith: '\wmic.exe'
    CommandLine|contains|all:
      - 'shadowcopy'
      - 'delete'
  selection_ps:
    CommandLine|contains: 'Win32_ShadowCopy'
    CommandLine|contains:
      - 'Delete'
      - 'Remove'
  condition: selection_wmic or selection_ps
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Backup maintenance removing old snapshots
level: high
tags:
  - attack.impact
  - attack.t1490

title: DPAPI Master Key Access
id: d5042326-86a5-44d0-b665-3d80a9680d42
status: experimental
description: Detects DPAPI master key access.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'dpapi::masterkey'
      - 'SharpDPAPI'
      - '\Microsoft\Protect\'
      - 'dpapi::cred'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Backup or migration tools handling DPAPI
level: high
tags:
  - attack.credential_access
  - attack.t1555

title: Mimikatz Command Invocation
id: 45642fe1-75c7-46c2-a19c-3e23e6e7d328
status: experimental
description: Detects Mimikatz command syntax.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1003/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'sekurlsa::logonpasswords'
      - 'sekurlsa::pth'
      - 'lsadump::sam'
      - 'lsadump::dcsync'
      - 'privilege::debug'
      - 'crypto::capi'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Security research and detection engineering
level: critical
tags:
  - attack.credential_access
  - attack.t1003.001

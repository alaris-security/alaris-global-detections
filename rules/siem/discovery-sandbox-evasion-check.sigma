title: Sandbox and Virtualization Evasion Checks
id: 6d284b6a-f328-4d05-a677-ff677ce5f77b
status: experimental
description: Detects sandbox/VM evasion checks.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1497/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'VBoxGuest'
      - 'vmtoolsd'
      - 'VBoxService'
      - 'SbieDll'
      - 'wmic bios'
      - 'wmic computersystem get model'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Legitimate VM management tools
level: medium
tags:
  - attack.discovery
  - attack.t1497.001

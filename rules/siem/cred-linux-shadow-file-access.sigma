title: Linux /etc/shadow Password Hash Access
id: 09f55b1a-510d-4e28-8034-632f7ba5d442
status: experimental
description: Detects access to /etc/shadow.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1003/008/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    CommandLine|contains: '/etc/shadow'
    Image|endswith:
      - '/cat'
      - '/cp'
      - '/less'
      - '/more'
      - '/head'
      - '/tail'
      - '/unshadow'
      - '/vi'
      - '/nano'
  condition: selection
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Administrators inspecting shadow during maintenance
level: high
tags:
  - attack.credential_access
  - attack.t1003.008

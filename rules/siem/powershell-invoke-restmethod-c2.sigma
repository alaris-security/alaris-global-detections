title: PowerShell Invoke-RestMethod C2 Polling
id: f58a90f5-4660-4577-a2ec-2c7bee8bf4e1
status: experimental
description: Detects PowerShell using Invoke-RestMethod/Invoke-WebRequest in a loop to poll a remote endpoint and execute returned content, a lightweight web-protocol command-and-control pattern.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1071/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Invoke-RestMethod'
      - 'Invoke-WebRequest'
    CommandLine|contains:
      - 'while('
      - 'Start-Sleep'
    CommandLine|contains:
      - 'IEX'
      - 'Invoke-Expression'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Legitimate API polling scripts
level: medium
tags:
  - attack.command_and_control
  - attack.t1071.001

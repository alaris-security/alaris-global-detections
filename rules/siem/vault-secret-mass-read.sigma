title: HashiCorp Vault Mass Secret Read
id: 64846eb1-9568-466b-a420-6f36d5e63690
status: experimental
description: Detects a single token or entity reading a large number of Vault secret paths in a short window, indicating bulk harvesting of secrets from the vault.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  category: application
detection:
  selection:
    type: 'response'
    request_operation: 'read'
    request_path|contains: 'secret/'
  timeframe: 10m
  condition: selection | count() by auth_entity_id > 25
  condition: selection
fields:
  - auth_entity_id
  - request_path
  - remote_address
falsepositives:
  - Applications loading many secrets on startup
level: high
tags:
  - attack.credential_access
  - attack.t1552

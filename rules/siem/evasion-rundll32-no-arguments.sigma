title: Rundll32 Executed Without Arguments
id: da641e62-3b1b-4fca-ade9-e72f0613b3e5
status: experimental
description: Detects rundll32 with no arguments.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1218/011/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\rundll32.exe'
  filter:
    CommandLine|contains: '.dll'
  filter_null:
    CommandLine: null
  condition: selection and not filter and not filter_null
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Rare legitimate argument-less invocation
level: high
tags:
  - attack.defense_evasion
  - attack.t1218.011

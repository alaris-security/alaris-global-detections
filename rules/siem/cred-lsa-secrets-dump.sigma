title: LSA Secrets Access via Security Policy Registry
id: 844f909f-cac1-47aa-9706-389a7530caa8
status: experimental
description: Detects access to LSA secrets storage.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1003/004/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'SECURITY\Policy\Secrets'
      - 'lsadump'
      - 'secretsdump'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Authorized security assessment tooling
level: critical
tags:
  - attack.credential_access
  - attack.t1003.004

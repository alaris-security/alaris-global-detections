title: Windows Service Enumeration
id: e79d391b-44da-422f-9937-5c6ee8a24b64
status: experimental
description: Detects service enumeration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1007/
logsource:
  product: windows
  category: process_creation
detection:
  selection_sc:
    Image|endswith: '\sc.exe'
    CommandLine|contains:
      - 'query'
      - 'queryex'
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|endswith: 'start'
  condition: selection_sc or selection_net
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Administrative service checks
level: low
tags:
  - attack.discovery
  - attack.t1007

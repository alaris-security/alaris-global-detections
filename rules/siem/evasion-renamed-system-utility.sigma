title: Renamed System Utility Execution
id: b684dbfd-a474-4e4a-8058-890ec6ae96aa
status: experimental
description: Detects renamed system utilities via OriginalFileName.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1036/003/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    OriginalFileName:
      - 'PowerShell.EXE'
      - 'Cmd.Exe'
      - 'RUNDLL32.EXE'
      - 'reg.exe'
      - 'wmic.exe'
  filter:
    Image|endswith:
      - '\powershell.exe'
      - '\cmd.exe'
      - '\rundll32.exe'
      - '\reg.exe'
      - '\wmic.exe'
  condition: selection and not filter
fields:
  - Image
  - OriginalFileName
  - CommandLine
falsepositives:
  - Some software bundles renamed copies
level: high
tags:
  - attack.defense_evasion
  - attack.t1036.003

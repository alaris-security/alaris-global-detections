title: Private Key and Certificate Theft
id: 490d8027-ba56-4c87-b7f4-291eadfa8d37
status: experimental
description: Detects access to private key and certificate files.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/004/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'id_rsa'
      - 'id_ed25519'
      - '.pem'
      - '.pfx'
      - '.p12'
      - '.ppk'
      - '.key'
  selection_tool:
    Image|endswith:
      - '\cmd.exe'
      - '\powershell.exe'
      - '/cp'
      - '/tar'
      - '/scp'
      - '/cat'
  condition: selection and selection_tool
fields:
  - CommandLine
  - Image
falsepositives:
  - Legitimate certificate deployment and backup
level: high
tags:
  - attack.credential_access
  - attack.t1552.004

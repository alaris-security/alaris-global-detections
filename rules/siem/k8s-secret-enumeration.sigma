title: Kubernetes Secret Enumeration
id: 72980fc8-6136-46d5-bfae-ffdf183a0107
status: experimental
description: Detects enumeration of Kubernetes secrets.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/007/
logsource:
  product: kubernetes
  service: audit
detection:
  selection:
    verb:
      - 'list'
      - 'get'
    objectRef.resource: 'secrets'
  filter:
    user.username|startswith: 'system:'
  condition: selection and not filter
fields:
  - user.username
  - objectRef.namespace
  - sourceIPs
falsepositives:
  - Controllers and operators reading secrets
level: high
tags:
  - attack.credential_access
  - attack.t1552.007

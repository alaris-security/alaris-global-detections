title: GCP Custom IAM Role with Sensitive Permissions
id: 83e2556a-4960-403b-a199-4788dc730437
status: experimental
description: Detects custom IAM roles with sensitive permissions.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/
logsource:
  product: gcp
  service: gcp.audit
detection:
  selection:
    data.protoPayload.methodName|contains:
      - 'CreateRole'
      - 'UpdateRole'
    data.protoPayload.request|contains:
      - 'setIamPolicy'
      - 'serviceAccountKeys.create'
      - 'iam.roles.update'
      - 'iam.serviceAccounts.actAs'
  condition: selection
fields:
  - data.protoPayload.authenticationInfo.principalEmail
  - data.protoPayload.resourceName
falsepositives:
  - Legitimate custom role design
level: high
tags:
  - attack.privilege_escalation
  - attack.t1098

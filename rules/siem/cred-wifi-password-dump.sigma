title: Wi-Fi Password Extraction via netsh
id: a6334d3e-eac2-4f3d-bac4-b9349d483d57
status: experimental
description: Detects Wi-Fi password extraction.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\netsh.exe'
    CommandLine|contains|all:
      - 'wlan'
      - 'show'
      - 'key=clear'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - IT recovering Wi-Fi credentials
level: medium
tags:
  - attack.credential_access
  - attack.t1555

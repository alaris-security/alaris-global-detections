title: Kerberoasting SPN Enumeration via setspn
id: 2db24bb1-4295-418c-be13-f5f1a0469059
status: experimental
description: Detects setspn -q or -l enumerating service principal names across the domain, the reconnaissance step attackers perform to identify Kerberoastable service accounts.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1558/003/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\\setspn.exe'
    CommandLine|contains:
      - '-q'
      - '-l'
      - '-t'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Administrators auditing SPNs
level: medium
tags:
  - attack.credential_access
  - attack.t1558.003

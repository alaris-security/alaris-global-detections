title: Account Access Removal and Lockout
id: fe58f876-3698-46d9-ab10-cf8c2697a032
status: experimental
description: Detects account disabling and forced password changes.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1531/
logsource:
  product: windows
  category: process_creation
detection:
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains: 'user'
    CommandLine|contains:
      - '/active:no'
      - '/delete'
  selection_ps:
    CommandLine|contains:
      - 'Disable-ADAccount'
      - 'Set-ADAccountPassword'
      - 'Remove-ADUser'
  condition: selection_net or selection_ps
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - HR-driven account deprovisioning
level: high
tags:
  - attack.impact
  - attack.t1531

title: Domain Group Discovery (Privileged Groups)
id: c32eed0f-55f3-492a-b312-c6f230773076
status: experimental
description: Detects privileged domain group enumeration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1069/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains|all:
      - 'group'
      - '/domain'
  selection_priv:
    CommandLine|contains:
      - 'Domain Admins'
      - 'Enterprise Admins'
      - 'Get-ADGroupMember'
  condition: selection_net or selection_priv
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Identity governance tooling
level: medium
tags:
  - attack.discovery
  - attack.t1069.002

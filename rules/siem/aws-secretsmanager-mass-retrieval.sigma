title: AWS Secrets Manager Mass Secret Retrieval
id: ef336b56-bc9e-4c4e-b065-0186233bbd67
status: experimental
description: Detects bulk secret retrieval.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  product: aws
  service: cloudtrail
detection:
  selection:
    eventSource: 'secretsmanager.amazonaws.com'
    eventName:
      - 'GetSecretValue'
      - 'BatchGetSecretValue'
  timeframe: 10m
  condition: selection | count() by userIdentity.arn > 15
fields:
  - userIdentity.arn
  - requestParameters.secretId
  - sourceIPAddress
falsepositives:
  - Applications retrieving many secrets on startup
level: high
tags:
  - attack.credential_access
  - attack.t1552.001

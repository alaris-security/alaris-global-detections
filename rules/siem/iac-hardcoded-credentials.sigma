title: Hardcoded Credentials Committed to IaC
id: 55e209a2-fdcb-4adc-8f3b-4164bc0a5fc5
status: experimental
description: Detects commits adding hardcoded secrets to infrastructure-as-code or config files (AWS keys, private keys, connection strings with passwords), which expose credentials in version control.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  category: application
detection:
  selection:
    diff_added|contains:
      - 'AKIA'
      - 'BEGIN RSA PRIVATE KEY'
      - 'BEGIN OPENSSH PRIVATE KEY'
      - 'password ='
      - 'aws_secret_access_key'
  condition: selection
fields:
  - repo
  - file
  - actor
falsepositives:
  - Test fixtures or placeholder values
level: high
tags:
  - attack.credential_access
  - attack.t1552.001

title: AutoLogon Plaintext Password in Registry
id: f4f04ef0-0902-4b4e-a325-5dd3a03361b6
status: experimental
description: Detects access to AutoLogon registry password.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'DefaultPassword'
      - 'AutoAdminLogon'
    CommandLine|contains: 'Winlogon'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Administrators configuring autologon
level: medium
tags:
  - attack.credential_access
  - attack.t1552.002

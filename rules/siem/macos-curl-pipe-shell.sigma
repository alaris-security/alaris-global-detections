title: macOS Curl Piped to Shell
id: 67949e02-fb79-47e0-9f08-6e9e243d68f6
status: experimental
description: Detects downloading and directly executing a script by piping curl output into bash/sh/zsh on macOS, a one-line ingress-and-execute pattern common to macOS malware installers.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/004/
logsource:
  product: macos
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'curl'
    CommandLine|contains:
      - '| bash'
      - '| sh'
      - '| zsh'
      - '|bash'
  condition: selection
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Documented vendor install scripts
level: high
tags:
  - attack.execution
  - attack.t1059.004

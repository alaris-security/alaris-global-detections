title: Windows Credential Manager Vault Access
id: 0a13e22e-f153-4428-b856-e29859c3b04d
status: experimental
description: Detects Windows Credential Manager enumeration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/004/
logsource:
  product: windows
  category: process_creation
detection:
  selection_vaultcmd:
    Image|endswith: '\vaultcmd.exe'
    CommandLine|contains:
      - '/list'
      - '/listcreds'
  selection_cmdkey:
    Image|endswith: '\cmdkey.exe'
    CommandLine|contains: '/list'
  condition: selection_vaultcmd or selection_cmdkey
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Administrators auditing stored credentials
level: high
tags:
  - attack.credential_access
  - attack.t1555.004

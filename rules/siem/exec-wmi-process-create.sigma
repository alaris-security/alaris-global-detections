title: Local Process Creation via WMI
id: 0898f943-e749-4c74-8ded-0741baaa7050
status: experimental
description: Detects WMI-based local process creation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1047/
logsource:
  product: windows
  category: process_creation
detection:
  selection_wmic:
    Image|endswith: '\wmic.exe'
    CommandLine|contains|all:
      - 'process'
      - 'call'
      - 'create'
  selection_prov:
    ParentImage|endswith: '\WmiPrvSE.exe'
    Image|endswith:
      - '\cmd.exe'
      - '\powershell.exe'
  condition: selection_wmic or selection_prov
fields:
  - CommandLine
  - ParentImage
  - Image
falsepositives:
  - Management tools using WMI to launch tasks
level: high
tags:
  - attack.execution
  - attack.t1047

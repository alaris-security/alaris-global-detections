title: GCP IAM Policy Grant of Owner or Editor
id: 5ffcc8df-c269-4a36-af79-b4e20f1f8bad
status: experimental
description: Detects IAM grants of owner/editor roles.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/003/
logsource:
  product: gcp
  service: gcp.audit
detection:
  selection:
    data.protoPayload.methodName|endswith: 'SetIamPolicy'
    data.protoPayload.serviceData.policyDelta.bindingDeltas.role:
      - 'roles/owner'
      - 'roles/editor'
    data.protoPayload.serviceData.policyDelta.bindingDeltas.action: 'ADD'
  condition: selection
fields:
  - data.protoPayload.authenticationInfo.principalEmail
  - data.protoPayload.resourceName
falsepositives:
  - Authorized role grants
level: high
tags:
  - attack.privilege_escalation
  - attack.t1098.003

title: Data Staged in Password-Protected Archive
id: ce415665-f629-4be3-8f44-727a9b7d3c5f
status: experimental
description: Detects archiving of data with passwords.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1560/001/
logsource:
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\rar.exe'
      - '\7z.exe'
      - '\7za.exe'
      - '\WinRAR.exe'
    CommandLine|contains:
      - ' a '
      - '-hp'
      - '-p'
      - '-r'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Legitimate backups producing encrypted archives
level: high
tags:
  - attack.collection
  - attack.t1560.001

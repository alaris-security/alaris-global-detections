title: Pcalua Program Compatibility Proxy Execution
id: 0f544cef-55d1-42cc-a968-4428cfc2aac6
status: experimental
description: Detects pcalua proxy execution abuse.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1218/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\pcalua.exe'
    CommandLine|contains: '-a'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Program Compatibility Assistant genuinely relaunching legacy apps
level: medium
tags:
  - attack.defense_evasion
  - attack.t1218

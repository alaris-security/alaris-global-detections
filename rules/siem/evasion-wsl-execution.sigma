title: Windows Subsystem for Linux Command Execution
id: 2b64d081-4804-4b3c-86c5-bd2f7e441e04
status: experimental
description: Detects WSL command execution.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1202/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\wsl.exe'
      - '\bash.exe'
    CommandLine|contains:
      - '-e'
      - '-c'
      - 'bash'
      - 'exec'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Developers using WSL legitimately
level: medium
tags:
  - attack.defense_evasion
  - attack.t1202

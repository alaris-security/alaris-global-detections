title: SSH Agent and ControlMaster Session Hijack
id: d52ab0cd-21d7-41d5-8bdf-5bd118a0d981
status: experimental
description: Detects SSH agent/ControlMaster session reuse.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1563/001/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    Image|endswith: '/ssh'
    CommandLine|contains:
      - 'SSH_AUTH_SOCK'
      - '-S /tmp/'
      - 'ControlPath'
      - '-o ControlMaster'
  condition: selection
fields:
  - CommandLine
  - User
  - ParentImage
falsepositives:
  - Legitimate SSH multiplexing configurations
level: high
tags:
  - attack.lateral_movement
  - attack.t1563.001

title: GCP Secret Manager Bulk Secret Access
id: 248e050d-71fc-4069-ba65-b63cada525f2
status: experimental
description: Detects bulk Secret Manager access.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  product: gcp
  service: gcp.audit
detection:
  selection:
    data.protoPayload.methodName|contains: 'AccessSecretVersion'
  timeframe: 10m
  condition: selection | count() by data.protoPayload.authenticationInfo.principalEmail > 15
fields:
  - data.protoPayload.authenticationInfo.principalEmail
  - data.protoPayload.resourceName
falsepositives:
  - Applications loading many secrets
level: high
tags:
  - attack.credential_access
  - attack.t1552.001

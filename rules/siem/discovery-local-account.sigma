title: Local Account Discovery
id: 06423d11-3a6c-4dd3-ab17-eff568caa4eb
status: experimental
description: Detects local account enumeration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1087/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains: 'user'
  filter_domain:
    CommandLine|contains: '/domain'
  selection_ps:
    CommandLine|contains: 'Get-LocalUser'
  condition: (selection_net and not filter_domain) or selection_ps
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Administrators auditing accounts
level: low
tags:
  - attack.discovery
  - attack.t1087.001

title: Kubernetes Service Account Token Request
id: 71e59ebf-2fb6-4b95-8648-5e64f97b0ba7
status: experimental
description: Detects service account token requests.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1528/
logsource:
  product: kubernetes
  service: audit
detection:
  selection:
    verb: 'create'
    objectRef.resource: 'serviceaccounts'
    objectRef.subresource: 'token'
  condition: selection
fields:
  - user.username
  - objectRef.namespace
  - objectRef.name
falsepositives:
  - Controllers minting projected tokens
level: high
tags:
  - attack.credential_access
  - attack.t1528

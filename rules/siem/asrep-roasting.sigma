title: AS-REP Roasting via Preauth-Disabled Accounts
id: 5b0f0ed2-3693-4287-82f6-f86f95334d23
status: experimental
description: Detects AS-REQ events for pre-authentication disabled accounts with RC4.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1558/004/
logsource:
  product: windows
  service: security
detection:
  selection:
    EventID: 4768
    PreAuthType: '0'
    TicketEncryptionType: '0x17'
  condition: selection
fields:
  - TargetUserName
  - IpAddress
  - PreAuthType
  - TicketEncryptionType
falsepositives:
  - Legitimate accounts intentionally configured without pre-authentication
level: high
tags:
  - attack.credential_access
  - attack.t1558.004

title: macOS osascript AppleScript Execution
id: d6b40bfa-2e02-4bb8-983b-ab645df6c3b0
status: experimental
description: Detects suspicious osascript execution.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/002/
logsource:
  product: macos
  category: process_creation
detection:
  selection:
    Image|endswith: '/osascript'
    CommandLine|contains:
      - 'do shell script'
      - 'display dialog'
      - 'password'
      - 'curl'
      - 'base64'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Legitimate automation using AppleScript
level: medium
tags:
  - attack.execution
  - attack.t1059.002

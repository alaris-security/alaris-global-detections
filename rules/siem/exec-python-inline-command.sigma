title: Suspicious Inline Python Execution
id: 2a0e78c2-23d1-4bca-bd7b-7b57ab5d21e7
status: experimental
description: Detects suspicious inline python one-liners.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/006/
logsource:
  category: process_creation
detection:
  selection:
    Image|contains: 'python'
    CommandLine|contains: '-c'
    CommandLine|contains:
      - 'import socket'
      - 'import subprocess'
      - 'os.system'
      - 'pty.spawn'
      - 'base64'
      - '/bin/sh'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Developer one-liners and automation
level: medium
tags:
  - attack.execution
  - attack.t1059.006

title: Windows Sticky Notes Data Access
id: 8d3984f2-3b24-44af-8048-96d3c9132bf5
status: experimental
description: Detects access to the Windows Sticky Notes database (plum.sqlite), which frequently contains passwords and sensitive reminders users store in notes.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1005/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'plum.sqlite'
    Image|endswith:
      - '/sqlite3'
      - '/cat'
      - '/cp'
      - '\\powershell.exe'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Backup software
level: low
tags:
  - attack.collection
  - attack.t1005

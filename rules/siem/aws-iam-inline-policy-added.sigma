title: AWS Inline IAM Policy Added
id: 81b034cc-a571-4ee0-9a38-dedfbd41cfe2
status: experimental
description: Detects inline IAM policy additions.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/003/
logsource:
  product: aws
  service: cloudtrail
detection:
  selection:
    eventSource: 'iam.amazonaws.com'
    eventName:
      - 'PutUserPolicy'
      - 'PutRolePolicy'
      - 'PutGroupPolicy'
  condition: selection
fields:
  - userIdentity.arn
  - requestParameters.policyName
falsepositives:
  - Legitimate permission grants
level: high
tags:
  - attack.privilege_escalation
  - attack.t1098.003

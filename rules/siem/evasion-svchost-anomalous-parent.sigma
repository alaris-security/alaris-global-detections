title: svchost.exe with Anomalous Parent
id: 74ba75f8-f5eb-4ed1-91c9-ad4d336dfe13
status: experimental
description: Detects svchost with an unexpected parent.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1036/005/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\svchost.exe'
  filter:
    ParentImage|endswith:
      - '\services.exe'
      - '\MsMpEng.exe'
      - '\ngen.exe'
      - '\svchost.exe'
  condition: selection and not filter
fields:
  - Image
  - ParentImage
  - CommandLine
falsepositives:
  - Rare legitimate service host launches
level: high
tags:
  - attack.defense_evasion
  - attack.t1036.005

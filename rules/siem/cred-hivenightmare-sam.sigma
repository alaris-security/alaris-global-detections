title: HiveNightmare SAM Access via Shadow Copy
id: 85a55462-adae-46b2-b6ac-f98ad7e894b1
status: experimental
description: Detects HiveNightmare SAM shadow copy access.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1003/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'HarddiskVolumeShadowCopy'
    CommandLine|contains:
      - '\SAM'
      - '\SYSTEM'
      - '\SECURITY'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Backup tools reading hives from shadow copies
level: high
tags:
  - attack.credential_access
  - attack.t1003.002

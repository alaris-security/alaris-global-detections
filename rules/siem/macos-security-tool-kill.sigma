title: macOS Security Tool Termination
id: 03b516bf-a3c9-4f3b-a176-a0e98373f736
status: experimental
description: Detects termination of macOS security tools.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/001/
logsource:
  product: macos
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '/killall'
      - '/launchctl'
      - '/kill'
    CommandLine|contains:
      - 'SentinelAgent'
      - 'CbDefense'
      - 'falcon'
      - 'CrowdStrike'
      - 'jamf'
      - 'santad'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Authorized agent maintenance
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.001

title: WScript/CScript Executing Script from Temp
id: 05f8b123-fdcb-475b-a715-b29ab03ad9d1
status: experimental
description: Detects script host execution from user temp paths.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/005/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\wscript.exe'
      - '\cscript.exe'
    CommandLine|contains:
      - '\AppData\'
      - '\Temp\'
      - '\Downloads\'
      - '\Users\Public\'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legacy business scripts stored in user profiles
level: high
tags:
  - attack.execution
  - attack.t1059.005

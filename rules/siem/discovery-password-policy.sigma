title: Password Policy Discovery
id: fb2e7b57-5ec7-4274-ade4-02235abf7560
status: experimental
description: Detects password policy discovery.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1201/
logsource:
  product: windows
  category: process_creation
detection:
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains: 'accounts'
  selection_ps:
    CommandLine|contains: 'Get-ADDefaultDomainPasswordPolicy'
  condition: selection_net or selection_ps
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Administrators reviewing policy
level: low
tags:
  - attack.discovery
  - attack.t1201

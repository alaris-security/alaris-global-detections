title: GitHub Repository Made Public
id: 89e36ebf-bcf6-4054-95b9-4da9f8e06e06
status: experimental
description: Detects repositories made public.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1567/
logsource:
  product: github
  service: audit
detection:
  selection:
    action: 'repo.access'
    visibility: 'public'
  condition: selection
fields:
  - actor
  - repo
falsepositives:
  - Intentional open-sourcing
level: high
tags:
  - attack.exfiltration
  - attack.t1567

title: Exfiltration over SMTP
id: 25949e09-1c9c-437d-bd59-eb71e1a445d4
status: experimental
description: Detects scripted SMTP data exfiltration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1048/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'Send-MailMessage'
    CommandLine|contains:
      - '-Attachments'
      - '-SmtpServer'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Legitimate automated reporting emails
level: medium
tags:
  - attack.exfiltration
  - attack.t1048

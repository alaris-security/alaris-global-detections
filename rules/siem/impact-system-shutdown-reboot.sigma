title: Forced System Shutdown or Reboot
id: e7da8466-07fb-4c3f-84b5-615724fd5dd4
status: experimental
description: Detects forced shutdown/reboot commands.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1529/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\shutdown.exe'
    CommandLine|contains:
      - '/r'
      - '/s'
    CommandLine|contains: '/f'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Patch cycles and maintenance reboots
level: medium
tags:
  - attack.impact
  - attack.t1529

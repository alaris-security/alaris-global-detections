title: RDP Session Hijack via tscon
id: 4193f409-b9f2-4440-8297-9e850aceba14
status: experimental
description: Detects RDP session hijacking via tscon.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1563/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\tscon.exe'
    CommandLine|contains: '/dest'
  condition: selection
fields:
  - CommandLine
  - ParentImage
  - User
falsepositives:
  - Help desk shadowing sessions with consent
level: high
tags:
  - attack.lateral_movement
  - attack.t1563.002

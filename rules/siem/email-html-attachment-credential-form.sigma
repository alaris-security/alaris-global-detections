title: HTML Attachment with Credential Form
id: 587a8cad-ac85-4c2f-b81d-d9eb1e53b6e6
status: experimental
description: Detects .html or .htm email attachments that contain a login form or obfuscated JavaScript, a technique to deliver a local credential-harvesting page that evades URL reputation checks.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1566/002/
logsource:
  category: mail
detection:
  selection:
    attachment_name|endswith:
      - '.html'
      - '.htm'
      - '.shtml'
    attachment_contains_form: true
  condition: selection
fields:
  - sender
  - recipient
  - subject
falsepositives:
  - Legitimate HTML reports
level: high
tags:
  - attack.initial_access
  - attack.t1566.002

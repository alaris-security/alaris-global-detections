title: Password Manager Database Access
id: e56e606d-1f48-48c4-8946-5d1501a3ff9e
status: experimental
description: Detects access to local password-manager vault files (KeePass kdbx, 1Password opvault, Bitwarden data.json, LastPass) by copy/read/archive tools, indicating theft of a stored credential vault.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1555/005/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '.kdbx'
      - 'opvault'
      - 'Bitwarden/data.json'
      - 'KeePass'
    Image|endswith:
      - '/cat'
      - '/cp'
      - '/tar'
      - '.exe'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Backup software copying vaults
level: high
tags:
  - attack.credential_access
  - attack.t1555.005

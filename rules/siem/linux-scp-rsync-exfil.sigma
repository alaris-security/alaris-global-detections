title: Data Exfiltration via scp/rsync
id: d71248d6-cbe1-4d98-938d-ea03f3946291
status: experimental
description: Detects bulk transfer of files to an external host via scp or rsync over SSH, an alternative-protocol exfiltration channel that blends with legitimate administration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1048/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '/scp'
      - '/rsync'
    CommandLine|contains:
      - '@'
      - ':'
    CommandLine|contains:
      - '-r'
      - '/etc/'
      - '/home/'
      - '/var/'
  condition: selection
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Legitimate backups and transfers
level: medium
tags:
  - attack.exfiltration
  - attack.t1048

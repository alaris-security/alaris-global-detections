title: Odbcconf DLL Registration Proxy Execution
id: 87e4afa7-0ade-4db8-9ac0-7343e4be5be3
status: experimental
description: Detects odbcconf DLL execution abuse.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1218/008/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\odbcconf.exe'
    CommandLine|contains:
      - 'REGSVR'
      - '/a'
      - '.rsp'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legitimate ODBC driver configuration
level: high
tags:
  - attack.defense_evasion
  - attack.t1218.008

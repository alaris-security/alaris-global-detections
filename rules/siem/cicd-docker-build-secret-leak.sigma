title: Secrets Baked into Docker Image Build
id: be9f884d-a90e-42f8-bb75-837eb7e9a47d
status: experimental
description: Detects docker build steps that copy credential files or set secret ARG/ENV values into an image layer, exposing secrets to anyone who pulls the resulting image.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  category: process_creation
detection:
  selection:
    Image|endswith: '/docker'
    CommandLine|contains: 'build'
  selection_secret:
    CommandLine|contains:
      - '--build-arg'
    CommandLine|contains:
      - 'SECRET'
      - 'TOKEN'
      - 'PASSWORD'
  condition: selection and selection_secret
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Legitimate build args
level: medium
tags:
  - attack.credential_access
  - attack.t1552

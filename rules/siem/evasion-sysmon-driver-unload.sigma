title: Sysmon Driver Unload or Service Stop
id: 8ad2adb5-bf80-4b8a-b09d-027665c709e4
status: experimental
description: Detects Sysmon driver unload or service stop.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection_fltmc:
    Image|endswith: '\fltmc.exe'
    CommandLine|contains: 'unload'
    CommandLine|contains:
      - 'SysmonDrv'
      - 'sysmon'
  selection_sc:
    CommandLine|contains:
      - 'stop sysmon'
      - 'delete sysmon'
      - 'stop SysmonDrv'
  condition: selection_fltmc or selection_sc
fields:
  - CommandLine
  - Image
falsepositives:
  - Authorized Sysmon upgrades or reconfiguration
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.001

title: PowerShell C2 Framework Stager
id: f0438bb1-f074-4e02-8815-05b76f27ce76
status: experimental
description: Detects PowerShell stagers from C2 frameworks such as Empire and Covenant, indicated by System.Net.WebClient with a base64 blob, System.Text.Encoding decode, and IEX in a single one-liner mirroring their default stager.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains: 'System.Net.WebClient'
    CommandLine|contains:
      - 'ReadToEnd'
      - 'DownloadString'
    CommandLine|contains:
      - 'IEX'
      - 'FromBase64String'
    CommandLine|contains:
      - '-nop'
      - '-w hidden'
      - '-noni'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Rare legitimate bootstrap scripts
level: critical
tags:
  - attack.command_and_control
  - attack.t1059.001

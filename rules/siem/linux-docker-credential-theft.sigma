title: Docker Registry Credential Theft
id: 67a05bbf-fd3a-4cde-b855-1b51edea64d1
status: experimental
description: Detects access to Docker registry credential files (~/.docker/config.json) by copy or read tools, which store base64-encoded registry credentials or auth tokens.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    CommandLine|contains: '.docker/config.json'
    Image|endswith:
      - '/cat'
      - '/cp'
      - '/base64'
      - '/tar'
  condition: selection
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Backup tooling
level: medium
tags:
  - attack.credential_access
  - attack.t1552.001

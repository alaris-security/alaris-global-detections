title: MSSQL xp_cmdshell Command Execution
id: d3a9fabc-2b26-440b-bcce-2c0a6bfe56cd
status: experimental
description: Detects the SQL Server database engine (sqlservr.exe) spawning cmd.exe or powershell, the artifact of xp_cmdshell being enabled and used to run OS commands from a compromised database.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith: '\\sqlservr.exe'
    Image|endswith:
      - '\\cmd.exe'
      - '\\powershell.exe'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legitimate DBA jobs using xp_cmdshell
level: critical
tags:
  - attack.execution
  - attack.t1059

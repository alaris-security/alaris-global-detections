title: Mass Service and Process Termination
id: 51ed7eb7-6dc4-4123-9396-05ddd7ab2e77
status: experimental
description: Detects stopping of database/backup/security services.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1489/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'net stop'
      - 'sc stop'
      - 'taskkill'
    CommandLine|contains:
      - 'sql'
      - 'veeam'
      - 'backup'
      - 'msexchange'
      - 'MSSQL'
      - 'Acronis'
      - 'SQLTELEMETRY'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Maintenance windows stopping services
level: high
tags:
  - attack.impact
  - attack.t1489

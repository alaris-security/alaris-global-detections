title: Network Configuration Discovery
id: c5a791bd-58c3-4232-95a9-c6feb91b34c1
status: experimental
description: Detects network configuration discovery commands.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1016/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\ipconfig.exe'
      - '\arp.exe'
      - '\route.exe'
      - '\getmac.exe'
      - '\nbtstat.exe'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Network troubleshooting by IT
level: low
tags:
  - attack.discovery
  - attack.t1016

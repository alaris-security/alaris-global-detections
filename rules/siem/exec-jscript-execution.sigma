title: JavaScript Execution via Script Host
id: c0e1bfaf-74a9-4dec-adea-6a51a51c102a
status: experimental
description: Detects JScript execution via WSH.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/007/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\cscript.exe'
      - '\wscript.exe'
    CommandLine|contains:
      - '//E:jscript'
      - '//E:javascript'
      - '.js'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legitimate JScript automation
level: high
tags:
  - attack.execution
  - attack.t1059.007

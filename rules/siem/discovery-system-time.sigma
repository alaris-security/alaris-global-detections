title: System Time Discovery
id: 4fa3c4e2-65bf-4d18-b6a4-aed8521a55a8
status: experimental
description: Detects system time discovery.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1124/
logsource:
  product: windows
  category: process_creation
detection:
  selection_net:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains: 'time'
  selection_w32tm:
    Image|endswith: '\w32tm.exe'
  condition: selection_net or selection_w32tm
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Time synchronization checks
level: low
tags:
  - attack.discovery
  - attack.t1124

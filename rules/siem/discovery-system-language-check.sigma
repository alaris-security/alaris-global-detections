title: System Language and Locale Check
id: 734cf648-a569-47c3-9fd6-a17911f414ca
status: experimental
description: Detects system language/locale checks.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1614/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'Get-Culture'
      - 'GetKeyboardLayout'
      - 'GetUserDefaultUILanguage'
      - 'InstalledUICulture'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Localization-aware applications
level: low
tags:
  - attack.discovery
  - attack.t1614.001

title: WMIC XSL Script Execution (Squiblytwo)
id: 05f746a8-28d5-479f-ba95-de268dd207f6
status: experimental
description: Detects wmic XSL script execution abuse.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1220/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\wmic.exe'
    CommandLine|contains:
      - '/format:'
      - 'format:http'
      - '.xsl'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Administrative scripts using custom XSL formatting
level: high
tags:
  - attack.defense_evasion
  - attack.t1220

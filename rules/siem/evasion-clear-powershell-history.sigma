title: PowerShell Console History Removal
id: f7abb882-4142-4aa9-a98c-a14114c493ce
status: experimental
description: Detects removal of PowerShell console history.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1070/003/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'ConsoleHost_history.txt'
      - 'Clear-History'
      - 'Remove-Item (Get-PSReadlineOption).HistorySavePath'
  condition: selection
fields:
  - CommandLine
  - Image
falsepositives:
  - Users clearing their own history
level: medium
tags:
  - attack.defense_evasion
  - attack.t1070.003

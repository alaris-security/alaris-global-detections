title: Broad File and Directory Discovery
id: 6532acb9-6456-4f8e-9f88-ad3f99c3498c
status: experimental
description: Detects broad file and directory enumeration.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1083/
logsource:
  product: windows
  category: process_creation
detection:
  selection_dir:
    CommandLine|contains:
      - 'dir /s'
      - 'dir C:\ /s'
      - 'tree /f'
  selection_ps:
    CommandLine|contains|all:
      - 'Get-ChildItem'
      - '-Recurse'
  condition: selection_dir or selection_ps
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Backup and search operations
level: low
tags:
  - attack.discovery
  - attack.t1083

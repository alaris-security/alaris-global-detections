title: AWS EC2 Windows Password Data Retrieved
id: c3ff0ead-5808-4ee7-b2a0-63f8e93d2e64
status: experimental
description: Detects retrieval of EC2 Windows password data.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  product: aws
  service: cloudtrail
detection:
  selection:
    eventSource: 'ec2.amazonaws.com'
    eventName: 'GetPasswordData'
  condition: selection
fields:
  - userIdentity.arn
  - requestParameters.instanceId
  - sourceIPAddress
falsepositives:
  - Administrators retrieving instance passwords
level: medium
tags:
  - attack.credential_access
  - attack.t1552

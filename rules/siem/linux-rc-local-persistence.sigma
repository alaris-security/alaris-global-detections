title: Linux rc.local Boot Persistence
id: df07c9de-3ebf-421a-b148-f60dcf779ff5
status: experimental
description: Detects rc.local/init script persistence.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1037/004/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '/etc/rc.local'
      - '/etc/init.d/'
      - '/etc/rc.d/'
  selection_write:
    CommandLine|contains:
      - 'echo '
      - 'tee '
      - '>>'
  condition: selection and selection_write
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Legacy init configuration by administrators
level: medium
tags:
  - attack.persistence
  - attack.t1037.004

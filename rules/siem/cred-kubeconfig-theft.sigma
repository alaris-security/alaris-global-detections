title: Kubeconfig Credential Theft
id: 146cfef2-4321-45c2-8f79-6f5c9fe2e1d9
status: experimental
description: Detects access to kubeconfig and SA tokens.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '.kube/config'
      - '/var/run/secrets/kubernetes.io/serviceaccount/token'
  selection_tool:
    Image|endswith:
      - '/cat'
      - '/cp'
      - '/tar'
      - '/base64'
  condition: selection and selection_tool
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Backup and CI tooling
level: high
tags:
  - attack.credential_access
  - attack.t1552.001

title: OneNote Embedded File Execution
id: 7dca5c6e-f400-40dc-8ad1-661c0351aa1d
status: experimental
description: Detects OneNote embedded file execution.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1566/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith: '\onenote.exe'
    Image|endswith:
      - '\cmd.exe'
      - '\powershell.exe'
      - '\wscript.exe'
      - '\cscript.exe'
      - '\mshta.exe'
      - '\rundll32.exe'
  condition: selection
fields:
  - ParentImage
  - Image
  - CommandLine
falsepositives:
  - Rare legitimate OneNote automation
level: high
tags:
  - attack.initial_access
  - attack.t1566.001

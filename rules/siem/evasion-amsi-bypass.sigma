title: AMSI Bypass via Reflection or amsiInitFailed
id: e22a9fbd-191c-4b2d-aa1c-85ef4ff024b6
status: experimental
description: Detects common AMSI bypass techniques.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/001/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'amsiInitFailed'
      - 'AmsiUtils'
      - 'AmsiScanBuffer'
      - 'System.Management.Automation.AmsiUtils'
      - 'amsi.dll'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - Security research and detection engineering
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.001

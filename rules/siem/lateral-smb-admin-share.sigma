title: SMB Administrative Share Access
id: 7b43a9b7-3ec0-4e35-a9bf-f792e435683c
status: experimental
description: Detects access to administrative SMB shares.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1021/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith:
      - '\net.exe'
      - '\net1.exe'
    CommandLine|contains: 'use'
    CommandLine|contains:
      - 'C$'
      - 'ADMIN$'
      - 'IPC$'
  condition: selection
fields:
  - CommandLine
  - ParentImage
  - User
falsepositives:
  - Administrative scripts mapping admin shares
level: medium
tags:
  - attack.lateral_movement
  - attack.t1021.002

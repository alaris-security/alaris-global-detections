title: GitHub Secret Scanning Disabled
id: 98ef21f9-b1a8-4ce8-8ceb-73dcf0dac1e4
status: experimental
description: Detects disabling of secret scanning.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/
logsource:
  product: github
  service: audit
detection:
  selection:
    action|contains:
      - 'secret_scanning.disable'
      - 'secret_scanning_push_protection.disable'
  condition: selection
fields:
  - actor
  - repo
falsepositives:
  - Administrative configuration changes
level: medium
tags:
  - attack.defense_evasion
  - attack.t1562

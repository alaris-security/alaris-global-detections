title: Azure Managed Identity Token Request from VM
id: b437e003-f3e8-440d-babb-7d255f8e790e
status: experimental
description: Detects managed identity token requests.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1528/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains: '169.254.169.254'
    CommandLine|contains: 'identity/oauth2/token'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - SDKs and agents fetching identity tokens
level: medium
tags:
  - attack.credential_access
  - attack.t1528

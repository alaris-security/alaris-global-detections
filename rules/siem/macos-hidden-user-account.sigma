title: macOS Hidden User Account Configuration
id: d9553fd8-3621-4bb6-9eb0-bf3ba552cfb5
status: experimental
description: Detects hiding of user accounts on macOS.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1564/002/
logsource:
  product: macos
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'IsHidden 1'
      - 'Hide500Users'
      - 'dscl . create /Users'
  condition: selection
fields:
  - CommandLine
  - User
falsepositives:
  - Legitimate service account hiding
level: medium
tags:
  - attack.defense_evasion
  - attack.t1564.002

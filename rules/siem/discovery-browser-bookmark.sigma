title: Browser Bookmark and History Discovery
id: 389c2a1c-cb5a-4150-80e3-740fb3454976
status: experimental
description: Detects browser bookmark/history discovery.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1217/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '\User Data\Default\Bookmarks'
      - '\User Data\Default\History'
      - 'places.sqlite'
  filter:
    Image|endswith:
      - '\chrome.exe'
      - '\msedge.exe'
      - '\firefox.exe'
  condition: selection and not filter
fields:
  - CommandLine
  - Image
falsepositives:
  - Backup software
level: low
tags:
  - attack.discovery
  - attack.t1217

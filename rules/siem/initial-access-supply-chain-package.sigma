title: Suspicious Package Install with Post-Install Execution
id: 6ecbf1c8-85f5-4698-b72f-d1f120cc3db9
status: experimental
description: Detects package post-install script execution.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1195/002/
logsource:
  category: process_creation
detection:
  selection:
    ParentImage|endswith:
      - '\npm.exe'
      - '\node.exe'
      - '/npm'
      - '/pip'
      - '/pip3'
      - '/gem'
    Image|endswith:
      - '/curl'
      - '/wget'
      - '/bash'
      - '/sh'
      - '\powershell.exe'
      - '\cmd.exe'
  condition: selection
fields:
  - ParentImage
  - Image
  - CommandLine
falsepositives:
  - Packages with legitimate native build steps
level: high
tags:
  - attack.initial_access
  - attack.t1195.002

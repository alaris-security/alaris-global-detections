title: System Owner and Logged-On User Discovery
id: 042e76a5-0565-413d-bf0d-79ce3fe158b4
status: experimental
description: Detects user and session discovery commands.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1033/
logsource:
  product: windows
  category: process_creation
detection:
  selection_whoami:
    Image|endswith: '\whoami.exe'
    CommandLine|contains:
      - '/all'
      - '/priv'
      - '/groups'
  selection_quser:
    Image|endswith:
      - '\quser.exe'
      - '\query.exe'
    CommandLine|contains: 'user'
  condition: selection_whoami or selection_quser
fields:
  - CommandLine
  - ParentImage
  - User
falsepositives:
  - Administrators and login scripts
level: low
tags:
  - attack.discovery
  - attack.t1033

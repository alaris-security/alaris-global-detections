title: Secret Harvesting from Process Environment
id: 68ce54b1-2a94-4b48-b56b-e3acd093f859
status: experimental
description: Detects harvesting of secrets from process environments.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/001/
logsource:
  category: process_creation
detection:
  selection_proc:
    CommandLine|contains: '/proc/'
    CommandLine|contains: '/environ'
  selection_env:
    CommandLine|contains: 'Get-ChildItem Env:'
  condition: selection_proc or selection_env
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Debugging and diagnostics
level: medium
tags:
  - attack.credential_access
  - attack.t1552.001

title: Remote Service Creation via sc.exe
id: e8d30de0-ebe0-40e8-baff-6ab77fdecbc1
status: experimental
description: Detects remote service creation with sc.exe.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1021/002/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\sc.exe'
    CommandLine|contains: '\\\\'
    CommandLine|contains:
      - 'create'
      - 'start'
      - 'config'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Remote administration of services by IT
level: high
tags:
  - attack.lateral_movement
  - attack.t1021.002

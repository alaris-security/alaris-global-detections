title: Linux System Logging Service Disabled
id: fd3cfba8-18e3-4d9a-a5b2-6d284604b63a
status: experimental
description: Detects disabling of syslog/journald.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/001/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'stop rsyslog'
      - 'mask rsyslog'
      - 'disable rsyslog'
      - 'stop systemd-journald'
      - 'mask systemd-journald'
  condition: selection
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Logging pipeline maintenance
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.001

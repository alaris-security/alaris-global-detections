title: Credential Search in Shell History Files
id: 1514e705-a566-439b-bab4-f51f6fd535b2
status: experimental
description: Detects credential hunting in shell history files.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/003/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - '.bash_history'
      - '.zsh_history'
      - '.sh_history'
  selection_kw:
    CommandLine|contains:
      - 'password'
      - 'passwd'
      - 'token'
      - 'secret'
      - 'ssh'
      - 'aws'
  condition: selection and selection_kw
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Users searching their own history
level: medium
tags:
  - attack.credential_access
  - attack.t1552.003

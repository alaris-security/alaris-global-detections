title: Azure Sentinel Analytics Rule Deleted
id: 82509b87-15ae-4c5c-9dfc-d52a655f8222
status: experimental
description: Detects deletion of Microsoft Sentinel analytics rules or data connectors, a defense-evasion action that removes cloud detection coverage.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1562/008/
logsource:
  product: azure
  service: activitylogs
detection:
  selection:
    operationName|contains:
      - 'MICROSOFT.SECURITYINSIGHTS/ALERTRULES/DELETE'
      - 'MICROSOFT.SECURITYINSIGHTS/DATACONNECTORS/DELETE'
  condition: selection
fields:
  - caller
  - resourceId
  - operationName
falsepositives:
  - Detection engineering changes
level: high
tags:
  - attack.defense_evasion
  - attack.t1562.008

title: Computer Account Created (4741)
id: c4bb673d-227a-4d51-97ba-d951a9b5f0f5
status: experimental
description: Detects creation of a computer/machine account (event 4741) by a non-administrator, which is abused in attacks such as noPac/sAMAccountName spoofing and resource-based constrained delegation.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1136/
logsource:
  product: windows
  service: security
detection:
  selection:
    EventID: 4741
  filter:
    SubjectUserName|endswith: '$'
  condition: selection and not filter
  condition: selection
fields:
  - SubjectUserName
  - TargetUserName
  - IpAddress
falsepositives:
  - Legitimate domain joins by IT
level: medium
tags:
  - attack.persistence
  - attack.t1136

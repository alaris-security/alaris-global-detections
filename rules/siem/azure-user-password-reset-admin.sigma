title: Entra ID Admin-Initiated Password Reset
id: 8346a29a-1e47-45cd-9472-2a39c6124728
status: experimental
description: Detects admin-initiated password resets.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/
logsource:
  product: azure
  service: auditlogs
detection:
  selection:
    OperationName:
      - 'Reset user password'
      - 'Reset password (self-service)'
      - 'Set force change user password'
  condition: selection
fields:
  - InitiatedBy
  - TargetResources
falsepositives:
  - Routine help desk password resets
level: medium
tags:
  - attack.persistence
  - attack.t1098

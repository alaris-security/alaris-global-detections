title: Scheduled Data Transfer to External Host
id: 410c8448-b498-4ac3-be9e-79890b3ef701
status: experimental
description: Detects scheduled tasks performing data transfers.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1029/
logsource:
  category: process_creation
detection:
  selection_task:
    CommandLine|contains:
      - 'schtasks'
      - 'crontab'
      - 'New-ScheduledTask'
  selection_transfer:
    CommandLine|contains:
      - 'curl'
      - 'Invoke-RestMethod'
      - 'Invoke-WebRequest'
      - 'scp'
      - 'wget'
  condition: selection_task and selection_transfer
fields:
  - CommandLine
  - Image
falsepositives:
  - Legitimate scheduled sync jobs
level: medium
tags:
  - attack.exfiltration
  - attack.t1029

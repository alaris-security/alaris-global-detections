title: Obfuscated Windows Command Line
id: f0e8b377-38a1-4cdc-9dab-05d8e926388f
status: experimental
description: Detects obfuscated cmd.exe command lines.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1059/003/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\cmd.exe'
    CommandLine|contains:
      - '^^'
      - 'c^m^d'
      - 'p^o^w'
      - '%comspec:~'
      - 'set /a'
      - '"=="'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Complex batch scripts using carets legitimately
level: medium
tags:
  - attack.execution
  - attack.t1059.003

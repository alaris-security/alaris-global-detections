title: Entra ID Service Principal Credential Added
id: c26a3b84-9ddf-44b4-bade-6cc219e05fd5
status: experimental
description: Detects credential additions to app/service principals.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/001/
logsource:
  product: azure
  service: auditlogs
detection:
  selection:
    OperationName:
      - 'Add service principal credentials'
      - 'Update application - Certificates and secrets management'
      - 'Add application'
  condition: selection
fields:
  - InitiatedBy
  - TargetResources
  - OperationName
falsepositives:
  - Legitimate app registration credential rotation
level: high
tags:
  - attack.persistence
  - attack.t1098.001

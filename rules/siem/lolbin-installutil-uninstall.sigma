title: InstallUtil Uninstall Method Code Execution
id: 4d9311df-c30b-4622-af4a-f17dc6274f6e
status: experimental
description: Detects installutil proxy execution via the uninstall method.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1218/004/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: '\installutil.exe'
    CommandLine|contains:
      - '/logfile='
      - 'LogToConsole=false'
      - '/U'
  condition: selection
fields:
  - CommandLine
  - ParentImage
falsepositives:
  - Legitimate .NET service installation and removal
level: high
tags:
  - attack.defense_evasion
  - attack.t1218.004

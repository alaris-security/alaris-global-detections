title: Linux Log File Deletion or Truncation
id: 44c7d0d9-bb14-478e-8a71-26024d711c00
status: experimental
description: Detects deletion/truncation of system logs.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1070/002/
logsource:
  product: linux
  category: process_creation
detection:
  selection:
    CommandLine|contains: '/var/log/'
  selection_action:
    CommandLine|contains:
      - 'rm '
      - 'truncate'
      - 'shred'
      - '> /var/log'
      - 'cat /dev/null'
  condition: selection and selection_action
fields:
  - CommandLine
  - User
  - Image
falsepositives:
  - Log rotation using truncate (usually logrotate)
level: high
tags:
  - attack.defense_evasion
  - attack.t1070.002

title: AWS Administrator Policy Attachment
id: 740b8b91-934f-4978-a59d-13a8650315d9
status: experimental
description: Detects attachment of privileged IAM policies.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1098/003/
logsource:
  product: aws
  service: cloudtrail
detection:
  selection:
    eventSource: 'iam.amazonaws.com'
    eventName:
      - 'AttachUserPolicy'
      - 'AttachRolePolicy'
      - 'AttachGroupPolicy'
    requestParameters.policyArn|contains:
      - 'AdministratorAccess'
      - 'PowerUserAccess'
      - 'IAMFullAccess'
  condition: selection
fields:
  - userIdentity.arn
  - requestParameters.policyArn
  - sourceIPAddress
falsepositives:
  - Legitimate privilege grants by administrators
level: high
tags:
  - attack.privilege_escalation
  - attack.t1098.003

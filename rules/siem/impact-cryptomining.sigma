title: Cryptocurrency Miner Execution
id: 756677e1-e191-45fc-a333-8f04fa406f45
status: experimental
description: Detects cryptominer execution and pool connections.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1496/
logsource:
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'stratum+tcp'
      - 'stratum+ssl'
      - 'xmrig'
      - '--donate-level'
      - 'nanopool'
      - 'minergate'
      - '--cpu-priority'
  condition: selection
fields:
  - CommandLine
  - Image
  - User
falsepositives:
  - Sanctioned mining or blockchain research
level: high
tags:
  - attack.impact
  - attack.t1496

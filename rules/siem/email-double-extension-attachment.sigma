title: Double-Extension Email Attachment
id: 18ae2609-cc6d-46a3-96e2-7554addfbc95
status: experimental
description: Detects attachments using a deceptive double extension (invoice.pdf.exe, report.docx.scr) that hides the true executable type from users relying on the visible extension.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1566/001/
logsource:
  category: mail
detection:
  selection:
    attachment_name|re: '\.(pdf|docx?|xlsx?|jpg|png|txt)\.(exe|scr|js|vbs|bat|com|pif)$'
  condition: selection
fields:
  - sender
  - recipient
  - subject
falsepositives:
  - None expected
level: high
tags:
  - attack.initial_access
  - attack.t1566.001

title: GitHub Actions Secret Exfiltration Attempt
id: 90ee937f-4730-48f5-b57b-23f2d04e2940
status: experimental
description: Detects secret exfiltration via Actions workflows.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  product: github
  service: audit
detection:
  selection:
    file|contains: '.github/workflows/'
    diff|contains:
      - 'secrets.'
      - 'curl'
      - 'toJSON(secrets)'
  condition: selection
fields:
  - actor
  - repo
falsepositives:
  - Legitimate use of secrets in workflows
level: high
tags:
  - attack.credential_access
  - attack.t1552

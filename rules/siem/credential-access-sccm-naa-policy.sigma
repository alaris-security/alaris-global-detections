title: SCCM Network Access Account Retrieval
id: 2b450cf8-d82f-47d7-a572-af86a2f56ebc
status: experimental
description: Detects retrieval of SCCM Network Access Account credentials from client policy (WMI queries to CCM_NetworkAccessAccount or reading the policy blob), which returns domain credentials attackers use for lateral movement.
author: Alaris Global
references:
  - https://attack.mitre.org/techniques/T1552/
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    CommandLine|contains:
      - 'CCM_NetworkAccessAccount'
      - 'NetworkAccessUsername'
      - 'root\\ccm\\policy'
  condition: selection
fields:
  - CommandLine
  - Image
  - ParentImage
falsepositives:
  - SCCM client operations
level: high
tags:
  - attack.credential_access
  - attack.t1552
